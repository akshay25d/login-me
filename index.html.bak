<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Akshay Santra Common Services Centre</title>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- PDF processing runs locally in the browser. -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf-lib/1.17.1/pdf-lib.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f5f3ff',
                            100: '#ede9fe',
                            500: '#7c3aed',
                            600: '#6d28d9',
                            700: '#5b21b6',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }
        html, body {
            width: 100%;
            min-height: 100%;
        }
        body {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            background: #ffffff;
            color: black;
            padding: 0;
            overflow-x: hidden;
        }
        .container {
            width: 100%;
            min-width: 0;
            max-width: none;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        .form-box, .form-box1 {
            width: 100%;
            min-height: auto;
            max-width: none;
            margin: 0;
            padding: 0;
            background: transparent;
            border-radius: 0;
            box-shadow: none;
            display: block;
        }
        .form-box form, .form-box1 form {
            width: 100%;
            max-width: none;
        }
        #log-in1, #reg-txt {
            font-size: 24px;
            text-align: center;
            margin-bottom: 6px;
            text-decoration: none;
            font-weight: 700;
        }
        #login-email, #login-password, #reg-name, #reg-password, #reg-number, #reg-email { 
            width: 100%;
            padding: 12px;
            background: #e7d5d5;
            border-radius: 6px;
            border: none;
            outline: none;
            font-size: 16px;
            color: #333;
            margin-bottom: 20px;
        }
        .btn-primary {
            width: 100%;
            padding: 12px;
            background: #5c43cd;
            color: #fff;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            font-weight: 500;
            margin-bottom: 20px;
            transition: 0.3s;
        }
        .btn-primary:hover {
            background: #3208ec;
        }
        p {
            text-align: center;
        }
        a {
            color: #5c43cd;
            text-decoration: none;
            font-weight: bold;
            cursor: pointer;
        }
        a:hover {
            text-decoration: underline;
        }
        .hidden {
            display: none !important;
        }
        .alert-success {
            background-color: #d4edda;
            color: #155724;
            padding: 10px;
            border-radius: 6px;
            margin-bottom: 20px;
            text-align: center;
            font-size: 14px;
        }
        .alert-error {
            background-color: #f8d7da;
            color: #721c24;
            padding: 10px;
            border-radius: 6px;
            margin-bottom: 20px;
            text-align: center;
            font-size: 14px;
        }

        /* preserved exact original header styles */
        .dropbtn {
            background-color: #04AA6D;
            color: white;
            padding: 10px 15px;
            font-size: 16px;
            border: none;
            border-radius: 10px;
            cursor: pointer;
        }
        .dropdown {
            position: relative;
            display: inline-block;
        }
        .dropdown-content {
            display: none;
            position: absolute;
            background-color: #f1f1f1;
            min-width: 180px;
            box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
            z-index: 50;
            border-radius: 8px;
            overflow: hidden;
        }
        .dropdown-content a {
            color: black;
            padding: 12px 16px;
            text-decoration: none;
            display: block;
            text-align: left;
        }
        .dropdown-content a:hover { background-color: #ddd; }
        .dropdown:hover .dropdown-content { display: block; }
        .dropdown:hover .dropbtn { background-color: #3e8e41; }

        #image1 {
            width: 50px;
            height: 50px;
            object-fit: cover;
            border-radius: 50%;
        }
        .box1 {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            padding: 15px;
            border-bottom: 5px solid black;
            background-color: #e7d5d5;
            border-radius: 20px 20px 0 0;
        }
        h1 {
            text-align: center;
            color: #7a22ed;
            font-size: 20px;
            font-weight: bold;
            padding: 10px;
            border: 2px solid rgb(14, 205, 148);
            background-color: lightblue;
            border-radius: 8px;
            margin: 15px 0;
        }
        .cotaniner1 {
            width: 100%;
            min-height: 100vh;
            position: relative;
            background: #ffffff;
            border-radius: 0;
            box-shadow: none;
            padding: clamp(12px, 2vw, 32px);
            overflow: hidden;
        }
        .cotaniner1::before {
            content: "";
            position: absolute;
            width: 300px;
            height: 300px;
            background: rgba(255, 0, 255, 0.15);
            border-radius: 50%;
            filter: blur(100px);
            z-index: 0;
            pointer-events: none;
            animation: glowMove 6s infinite alternate;
        }
        @keyframes glowMove {
            0% { transform: translate(-50px, -30px); }
            100% { transform: translate(150px, 80px); }
        }

        /* Custom scrollbar for modern dashboard tables */
        .custom-scrollbar::-webkit-scrollbar {
            height: 6px;
            width: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #c7d2fe;
            border-radius: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #818cf8;
        }

        /* Dashboard section switcher: keeps the workspace focused on one panel. */
        .dashboard-section-shortcut {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 9px 12px;
            border: 1px solid rgba(221, 214, 254, 0.9);
            border-radius: 10px;
            background: #ffffff;
            color: #4c1d95;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            transition: transform 0.2s ease, background-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
        }
        .dashboard-section-shortcut:hover {
            background: #f5f3ff;
            transform: translateY(-1px);
            box-shadow: 0 5px 12px rgba(91, 33, 182, 0.14);
        }
        .dashboard-section-shortcut.is-active {
            background: #6d28d9;
            color: #ffffff;
            border-color: #6d28d9;
            box-shadow: 0 5px 14px rgba(109, 40, 217, 0.28);
        }
        .dashboard-section-shortcut:focus-visible {
            outline: 3px solid rgba(167, 139, 250, 0.55);
            outline-offset: 2px;
        }
        .report-period-tab {
            border: 1px solid #ddd6fe;
            border-radius: 8px;
            background: #ffffff;
            color: #5b21b6;
            padding: 8px 12px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            transition: background-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
        }
        .report-period-tab:hover { background: #f5f3ff; }
        .report-period-tab.is-active {
            border-color: #6d28d9;
            background: #6d28d9;
            color: #ffffff;
            box-shadow: 0 4px 10px rgba(109, 40, 217, 0.2);
        }

        /* Passport-photo print sheet: measurements are kept in millimetres so the
           browser print dialog preserves the chosen passport-photo dimensions. */
        .passport-print-sheet {
            width: 210mm;
            min-height: 297mm;
            padding: 10mm;
            background: #fff;
            display: grid;
            grid-template-columns: repeat(var(--photo-columns), var(--photo-width));
            grid-auto-rows: var(--photo-height);
            gap: 3mm;
            align-content: start;
            box-shadow: 0 10px 25px rgba(15, 23, 42, 0.16);
        }
        .passport-photo-cell {
            width: var(--photo-width);
            height: var(--photo-height);
            overflow: hidden;
            background: #f8fafc;
            border: 0.2mm dashed #cbd5e1;
        }
        .passport-photo-cell img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
        }
        .passport-sheet-preview {
            margin: 0 auto;
            overflow: hidden;
            transform-origin: top center;
            max-width: 100%;
        }
        @media screen and (max-width: 768px) {
            .passport-sheet-preview {
                transform: scale(0.48);
                margin-bottom: -150mm;
            }
        }
        @media screen and (min-width: 769px) and (max-width: 1024px) {
            .passport-sheet-preview {
                transform: scale(0.68);
                margin-bottom: -90mm;
            }
        }
        @media print {
            @page { size: A4 portrait; margin: 0; }
            body.passport-photo-printing { display: block !important; padding: 0 !important; background: #fff !important; }
            body.passport-photo-printing * { visibility: hidden !important; }
            body.passport-photo-printing #passport-print-area, body.passport-photo-printing #passport-print-area * { visibility: visible !important; }
            body.passport-photo-printing #passport-print-area {
                position: absolute !important;
                top: 0 !important;
                left: 0 !important;
                width: 210mm !important;
                margin: 0 !important;
                padding: 0 !important;
            }
            body.passport-photo-printing #passportPhotoModal, body.passport-photo-printing #passportPhotoModal > div, body.passport-photo-printing #passport-photo-step-layout, body.passport-photo-printing #passport-photo-step-layout > div, body.passport-photo-printing #pps-layout-view {
                overflow: visible !important;
                max-height: none !important;
                background: transparent !important;
            }
            body.passport-photo-printing .passport-print-sheet {
                box-shadow: none !important;
                break-after: page;
                page-break-after: always;
            }
            body.passport-photo-printing .passport-print-sheet:last-child {
                break-after: auto;
                page-break-after: auto;
            }
        }

        /* Keep the dashboard edge-to-edge while preserving comfortable space
           around content on narrow screens. */
        @media (max-width: 640px) {
            .cotaniner1 {
                padding: 10px;
            }
            .box1 {
                gap: 10px;
                padding: 10px;
            }
        }

        /* ============================================================
           PASSPORT PHOTO PRINT STUDIO â€” Split-panel redesign
           ============================================================ */

        /* Dialog shell */
        .pps-dialog {
            display: flex;
            flex-direction: column;
            width: 100%;
            max-width: 1100px;
            max-height: 96vh;
            background: #fff;
            border-radius: 20px;
            box-shadow: 0 25px 60px rgba(15,23,42,0.22);
            border: 1px solid #f1f5f9;
            overflow: hidden;
        }

        /* Header with step indicator */
        .pps-header {
            flex-shrink: 0;
            padding: 18px 22px 14px;
            border-bottom: 1px solid #f1f5f9;
            background: #fff;
            position: relative;
        }

        /* Step indicator row */
        .pps-step-bar {
            display: flex;
            align-items: center;
            gap: 0;
            margin-top: 14px;
        }
        .pps-step {
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: 11px;
            font-weight: 700;
            color: #94a3b8;
            transition: color 0.3s;
            white-space: nowrap;
        }
        .pps-step.is-active  { color: #a21caf; }
        .pps-step.is-done    { color: #059669; }
        .pps-step-num {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: 800;
            background: #e2e8f0;
            color: #64748b;
            flex-shrink: 0;
            transition: background 0.3s, color 0.3s;
        }
        .pps-step.is-active  .pps-step-num { background: #a21caf; color: #fff; }
        .pps-step.is-done    .pps-step-num { background: #059669; color: #fff; }
        .pps-step-line {
            flex: 1;
            height: 2px;
            min-width: 18px;
            max-width: 48px;
            background: #e2e8f0;
            margin: 0 6px;
            border-radius: 2px;
            transition: background 0.3s;
        }
        .pps-step-line.is-done { background: #059669; }

        /* Body â€” left + right columns */
        .pps-body {
            display: flex;
            flex: 1;
            min-height: 0;
            overflow: hidden;
        }

        /* ---- LEFT PANEL ---- */
        .pps-left {
            width: 280px;
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
            border-right: 1px solid #f1f5f9;
            background: #fafafa;
            overflow-y: auto;
        }

        /* Upload zone (visible before photo selected) */
        .pps-upload-zone {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            flex: 1;
            min-height: 260px;
            padding: 24px 18px;
            margin: 16px;
            border: 2px dashed #e879f9;
            background: rgba(232,121,249,0.04);
            border-radius: 18px;
            cursor: pointer;
            text-align: center;
            transition: background 0.2s, border-color 0.2s;
        }
        .pps-upload-zone:hover {
            background: rgba(232,121,249,0.08);
            border-color: #c026d3;
        }

        /* Preview panel (visible after photo selected) */
        .pps-preview-panel {
            display: flex;
            flex-direction: column;
            align-items: center;
            flex: 1;
            padding: 12px 14px;
            position: relative;
            width: 100%;
        }
        .pps-preview-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            margin-bottom: 8px;
        }
        .pps-live-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 0.05em;
            color: #701a75;
            background: #fae8ff;
            border: 1px solid #f0abfc;
            padding: 2px 7px;
            border-radius: 12px;
        }
        .pps-live-dot {
            width: 6px;
            height: 6px;
            background: #c026d3;
            border-radius: 50%;
            display: inline-block;
            box-shadow: 0 0 0 0 rgba(192, 38, 211, 0.7);
            animation: ppsPulse 1.8s infinite;
        }
        @keyframes ppsPulse {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(192, 38, 211, 0.7); }
            70% { transform: scale(1.1); box-shadow: 0 0 0 5px rgba(192, 38, 211, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(192, 38, 211, 0); }
        }
        .pps-replace-pill-btn {
            display: inline-flex;
            align-items: center;
            font-size: 10px;
            font-weight: 700;
            color: #475569;
            background: #ffffff;
            border: 1px solid #cbd5e1;
            padding: 3px 8px;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.15s;
        }
        .pps-replace-pill-btn:hover {
            color: #0f172a;
            border-color: #94a3b8;
            background: #f8fafc;
        }
        .pps-preview-wrap {
            position: relative;
            width: 100%;
            max-width: 220px;
            margin: 0 auto;
        }
        .pps-live-stage {
            position: relative;
            width: 100%;
            overflow: hidden;
            border-radius: 12px;
            background-color: #ffffff;
            box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.18), 0 4px 10px -2px rgba(15, 23, 42, 0.08);
            border: 1.5px solid #e2e8f0;
            cursor: grab;
            user-select: none;
            touch-action: none;
            transition: background-color 0.2s, border-color 0.2s;
        }
        .pps-live-stage:active {
            cursor: grabbing;
        }
        .pps-live-img {
            position: absolute;
            left: 50%;
            top: 50%;
            max-width: none !important;
            max-height: none !important;
            transform-origin: center center;
            pointer-events: none;
            user-select: none;
            -webkit-user-drag: none;
            display: block;
        }
        /* Guidelines overlay */
        .pps-live-guides {
            position: absolute;
            inset: 0;
            pointer-events: none;
            transition: opacity 0.2s;
        }
        .pps-live-guides.hidden {
            display: none;
        }
        .pps-guide-border {
            position: absolute;
            inset: 0;
            border: 1.5px dashed rgba(255, 255, 255, 0.8);
            box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.25);
            border-radius: 12px;
            pointer-events: none;
        }
        .pps-guide-line-h {
            position: absolute;
            left: 0;
            right: 0;
            height: 1px;
            background: rgba(255, 255, 255, 0.7);
            box-shadow: 0 0 2px rgba(0, 0, 0, 0.5);
            pointer-events: none;
        }
        .pps-guide-eye {
            top: 35%;
        }
        .pps-guide-chin {
            top: 75%;
        }
        .pps-guide-line-v {
            position: absolute;
            top: 0;
            bottom: 0;
            left: 50%;
            width: 1px;
            background: rgba(255, 255, 255, 0.5);
            box-shadow: 0 0 2px rgba(0, 0, 0, 0.5);
            pointer-events: none;
        }
        /* Preview tools bar */
        .pps-preview-tools {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            width: 100%;
            margin-top: 8px;
        }
        .pps-tool-btn {
            font-size: 10px;
            font-weight: 600;
            color: #475569;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            padding: 4px 8px;
            border-radius: 8px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            transition: all 0.15s;
        }
        .pps-tool-btn:hover {
            color: #a21caf;
            border-color: #f0abfc;
            background: #fdf4ff;
        }
        .pps-tool-btn.is-active {
            color: #a21caf;
            background: #fdf4ff;
            border-color: #f0abfc;
        }
        .pps-preview-meta {
            margin-top: 8px;
            text-align: center;
            width: 100%;
        }
        .pps-preview-filename {
            font-size: 10px;
            color: #64748b;
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 230px;
            margin: 0 auto;
        }
        .pps-preview-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            margin-top: 5px;
            background: #fdf4ff;
            border: 1px solid #f0abfc;
            border-radius: 20px;
            padding: 2px 9px;
            font-size: 10px;
            font-weight: 700;
            color: #a21caf;
        }

        /* ---- RIGHT PANEL â€” sliding steps ---- */
        .pps-right {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-width: 0;
            overflow: hidden;
        }
        .pps-slides-viewport {
            flex: 1;
            overflow: hidden;
            position: relative;
        }
        .pps-slides-track {
            display: flex;
            height: 100%;
            transition: transform 0.42s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .pps-slide {
            flex-shrink: 0;
            width: 100%;
            height: 100%;
            overflow-y: auto;
            padding: 20px 22px;
            box-sizing: border-box;
        }
        .pps-slide-title {
            font-size: 13px;
            font-weight: 800;
            color: #1e293b;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* Slide nav buttons row */
        .pps-nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            padding: 14px 22px;
            border-top: 1px solid #f1f5f9;
            background: #fff;
            flex-shrink: 0;
        }
        .pps-btn-back {
            padding: 9px 16px;
            border: 1px solid #e2e8f0;
            background: #f8fafc;
            color: #475569;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: background 0.2s;
        }
        .pps-btn-back:hover { background: #f1f5f9; }
        .pps-btn-next {
            padding: 9px 20px;
            background: #a21caf;
            color: #fff;
            border: none;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: background 0.2s;
        }
        .pps-btn-next:hover:not(:disabled) { background: #86198f; }
        .pps-btn-next:disabled {
            background: #f0abfc;
            color: #e879f9;
            cursor: not-allowed;
        }
        .pps-btn-generate {
            padding: 9px 18px;
            background: #059669;
            color: #fff;
            border: none;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: background 0.2s;
        }
        .pps-btn-generate:hover { background: #047857; }

        /* Layout view (A4 preview) */
        #pps-layout-view {
            display: flex;
            flex-direction: column;
            flex: 1;
            min-height: 0;
            overflow: hidden;
        }
        .pps-layout-scroll {
            flex: 1;
            overflow-y: auto;
            background: #e2e8f0;
            padding: 16px;
            border-radius: 0;
        }

        /* Mobile: stack columns vertically */
        @media (max-width: 700px) {
            .pps-body       { flex-direction: column; }
            .pps-left       { width: 100%; border-right: none; border-bottom: 1px solid #f1f5f9; max-height: 290px; }
            .pps-upload-zone { min-height: 120px; margin: 10px; }
            .pps-preview-wrap { max-width: 150px; }
            .pps-dialog     { max-height: 99vh; border-radius: 14px; }
        }

        /* Print overrides for new IDs */
        @media print {
            body.passport-photo-printing #pps-layout-view,
            body.passport-photo-printing #pps-layout-view > div {
                overflow: visible !important;
                max-height: none !important;
                background: transparent !important;
            }
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- AUTH MODAL (LOGIN & REGISTER POPUP) -->
        <div id="authModal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/60 p-4 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="log-in1">
            <div class="relative w-full max-w-md rounded-2xl bg-white p-6 md:p-8 shadow-2xl border border-gray-100 max-h-[95vh] overflow-y-auto">
                <button type="button" onclick="closeAuthModal()" class="absolute top-4 right-4 text-gray-400 hover:text-gray-700 text-xl transition" title="Close" aria-label="Close">
                    <i class="fa-solid fa-xmark"></i>
                </button>
                
                <!-- LOGIN SCREEN -->
                <div class="form-box" id="login-screen">
                    <form id="login-form">
                        <div class="text-center mb-4">
                            <div class="w-12 h-12 rounded-xl bg-purple-100 text-purple-700 flex items-center justify-center text-xl mx-auto mb-2">
                                <i class="fa-solid fa-lock"></i>
                            </div>
                            <h2 id="log-in1">Operator Login</h2>
                            <p id="auth-modal-prompt" class="text-xs text-gray-500">Sign in to access CSC customer records, transactions & services.</p>
                        </div>
                        <div id="login-alert"></div>
                        <input type="email" id="login-email" placeholder="Email" required>
                        <input type="password" id="login-password" placeholder="Password" required>
                        <button type="submit" id="login-btn" class="btn-primary">Login</button>
                        <p class="text-center mt-2 text-xs">Don't have an account? <a id="show-register" class="text-purple-600 font-bold hover:underline cursor-pointer">Register</a></p>
                    </form>
                </div>

                <!-- REGISTER SCREEN -->
                <div class="form-box1 hidden" id="register-screen">
                    <form id="register-form">
                        <div class="text-center mb-4">
                            <div class="w-12 h-12 rounded-xl bg-purple-100 text-purple-700 flex items-center justify-center text-xl mx-auto mb-2">
                                <i class="fa-solid fa-user-plus"></i>
                            </div>
                            <h2 id="reg-txt">Register Operator</h2>
                            <p class="text-xs text-gray-500">Create operator account to manage CSC records.</p>
                        </div>
                        <div id="register-alert"></div>
                        <input type="text" id="reg-name" oninput="this.value=this.value.replace(/[^A-Za-z ]/g,'')" placeholder="Full Name" required>
                        <input type="number" id="reg-number" placeholder="Mobile Number" required>
                        <input type="email" id="reg-email" placeholder="Email" required>
                        <input type="password" id="reg-password" placeholder="Password" required>
                        <button type="submit" id="register-btn" class="btn-primary">Register</button>
                        <p class="text-center mt-2 text-xs">Already have an account? <a id="show-login" class="text-purple-600 font-bold hover:underline cursor-pointer">Login</a></p>
                    </form>
                </div>
            </div>
        </div>

        <!-- MAIN DASHBOARD SCREEN (OPENS DIRECTLY ON VISIT) -->
        <div class="cotaniner1" id="welcome-screen">
            
            <!-- PRESERVED HEADER (STRICT UNTOUCHED REQUIREMENT) -->
            <div class="box1">
                <div class="dropdown">
                    <button class="dropbtn"><i class="fa-solid fa-bars mr-1"></i> Menu</button>
                    <div class="dropdown-content">
                        <a href="#welcome-section"><i class="fa-solid fa-gauge mr-2"></i>Dashboard</a>
                        <a href="#services-section"><i class="fa-solid fa-list-check mr-2"></i>CSC Services</a>
                        <a href="#quick-actions-section"><i class="fa-solid fa-bolt mr-2"></i>Quick Actions</a>
                        <a href="#" onclick="openPdfToolsModal(); return false;"><i class="fa-solid fa-file-pdf mr-2"></i>PDF Tools</a>
                        <a href="#customers-section"><i class="fa-solid fa-users mr-2"></i>Customers</a>
                        <a href="#transactions-section"><i class="fa-solid fa-receipt mr-2"></i>Transactions</a>
                        <a href="#" onclick="openProfileModal(); return false;"><i class="fa-solid fa-id-card mr-2"></i>Profile</a>
                        <a href="#" onclick="openBusinessReport(); return false;"><i class="fa-solid fa-chart-line mr-2"></i>Reports</a>
                    </div>
                </div>
                <div class="flex items-center gap-3">
                    <button type="button" id="header-login-btn" onclick="openAuthModal()" class="px-3 py-1 bg-violet-600 hover:bg-violet-700 text-white rounded-lg text-xs font-bold transition shadow-sm flex items-center gap-1.5">
                        <i class="fa-solid fa-right-to-bracket"></i> Login
                    </button>
                    <h3 id="welcome-user-greeting" style="font-size: 15px; color: #333; font-weight: bold;">Welcome, Guest!</h3>
                    <img id="image1" src="Akshay.jpeg" alt="Profile" onerror="this.src='https://placehold.co/100x100/5c43cd/ffffff?text=AS'">
                </div>
            </div>

            <h1 id="center-name-heading">Akshay Santra Common Services Centre</h1>
            <!-- END PRESERVED HEADER -->

            <!-- DASHBOARD SECTION SHORTCUT BANNER -->
            <nav id="dashboard-section-shortcuts" class="relative z-10 mb-6 rounded-2xl border border-violet-200 bg-gradient-to-r from-violet-50 via-white to-indigo-50 p-4 shadow-sm" aria-label="Dashboard section shortcuts">
                <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                    <div>
                        <h2 class="text-sm font-bold text-violet-950 flex items-center gap-2">
                            <i class="fa-solid fa-table-cells-large text-violet-600"></i> Dashboard Shortcuts
                        </h2>
                        <p class="text-xs text-violet-700">Choose a section to keep only that workspace visible.</p>
                    </div>
                    <span class="text-[11px] font-semibold text-violet-700 bg-violet-100 px-2.5 py-1 rounded-full self-start sm:self-auto">One section at a time</span>
                </div>
                <div class="mt-3 flex flex-wrap gap-2" role="tablist" aria-label="Dashboard sections">
                    <button type="button" class="dashboard-section-shortcut is-active" data-dashboard-shortcut="welcome-section" aria-controls="welcome-section" aria-selected="true" onclick="showDashboardSection('welcome-section')">
                        <i class="fa-solid fa-house"></i> Welcome
                    </button>
                    <button type="button" class="dashboard-section-shortcut" data-dashboard-shortcut="performance-section" aria-controls="performance-section" aria-selected="false" onclick="showDashboardSection('performance-section')">
                        <i class="fa-solid fa-chart-line"></i> Performance
                    </button>
                    <button type="button" class="dashboard-section-shortcut" data-dashboard-shortcut="services-section" aria-controls="services-section" aria-selected="false" onclick="showDashboardSection('services-section')">
                        <i class="fa-solid fa-laptop-code"></i> Cyber Services
                    </button>
                    <button type="button" class="dashboard-section-shortcut" data-dashboard-shortcut="customers-section" aria-controls="customers-section" aria-selected="false" onclick="showDashboardSection('customers-section')">
                        <i class="fa-solid fa-users"></i> Customers
                    </button>
                    <button type="button" class="dashboard-section-shortcut" data-dashboard-shortcut="transactions-section" aria-controls="transactions-section" aria-selected="false" onclick="showDashboardSection('transactions-section')">
                        <i class="fa-solid fa-receipt"></i> Transactions
                    </button>
                    <button type="button" class="dashboard-section-shortcut" onclick="openBusinessReport()">
                        <i class="fa-solid fa-chart-pie"></i> Business Report
                    </button>
                </div>
            </nav>

            <!-- 1. DASHBOARD WELCOME SECTION -->
            <section id="welcome-section" data-dashboard-panel class="dashboard-panel relative z-10 bg-gradient-to-r from-purple-900 via-indigo-900 to-slate-900 rounded-2xl p-5 md:p-6 text-white shadow-xl mb-6">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <div>
                        <div class="inline-flex items-center gap-2 bg-purple-800/60 border border-purple-500/30 px-3 py-1 rounded-full text-xs font-semibold text-purple-200 mb-2">
                            <i class="fa-solid fa-shield-halved text-purple-400"></i> Official CSC Digital Portal
                        </div>
                        <h2 class="text-2xl md:text-3xl font-bold text-left !no-underline !mb-1 text-white">Welcome to Cycafe Dashboard</h2>
                        <p class="text-purple-200 text-sm md:text-base text-left">Manage your daily CSC and Cyber Cafe services from one place.</p>
                    </div>
                    
                    <div class="flex flex-wrap items-center gap-3 border-t border-purple-800/80 pt-3 md:pt-0 md:border-t-0">
                        <!-- Today's Date -->
                        <div class="bg-white/10 backdrop-blur-md px-3 py-2 rounded-xl border border-white/10 flex items-center gap-2 text-xs md:text-sm">
                            <i class="fa-regular fa-calendar-days text-purple-300 text-lg"></i>
                            <div>
                                <div class="text-xs text-purple-200 font-medium">Today's Date</div>
                                <div class="font-bold text-white" id="current-date-display">15 Sep 2026</div>
                            </div>
                        </div>

                        <!-- Working Status -->
                        <div class="bg-emerald-500/20 border border-emerald-500/40 px-3 py-2 rounded-xl flex items-center gap-2 text-xs md:text-sm">
                            <span class="relative flex h-3 w-3">
                              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                              <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
                            </span>
                            <div>
                                <div class="text-[11px] text-emerald-200 uppercase font-bold tracking-wider">Status</div>
                                <div class="font-bold text-emerald-300">CSC Active</div>
                            </div>
                        </div>

                        <!-- Notification Indicator -->
                        <button onclick="openModal('notificationModal')" class="relative bg-white/10 hover:bg-white/20 p-3 rounded-xl border border-white/10 transition text-white">
                            <i class="fa-regular fa-bell text-lg"></i>
                            <span class="absolute -top-1 -right-1 bg-rose-500 text-white text-[10px] font-bold h-5 w-5 rounded-full flex items-center justify-center border-2 border-purple-900 animate-bounce">3</span>
                        </button>
                    </div>
                </div>

                <!-- QUICK ACTIONS MERGED INTO THE WELCOME SCREEN -->
                <div id="quick-actions-section" class="mt-6 border-t border-purple-700/70 pt-5">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-lg font-bold text-white flex items-center gap-2">
                        <i class="fa-solid fa-bolt text-amber-500"></i> Quick Actions
                    </h3>
                    <span class="text-xs text-purple-200 font-medium">Frequently used shortcuts</span>
                </div>
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 xl:grid-cols-12 gap-2 md:gap-3">
                    <button onclick="openNewCustomerModal()" class="flex flex-col items-center justify-center p-3 bg-indigo-50 hover:bg-indigo-100 border border-indigo-200 rounded-xl transition text-center group shadow-sm hover:shadow">
                        <div class="w-10 h-10 rounded-lg bg-indigo-600 text-white flex items-center justify-center text-lg mb-2 group-hover:scale-110 transition-transform">
                            <i class="fa-solid fa-user-plus"></i>
                        </div>
                        <span class="text-xs font-semibold text-indigo-900 leading-tight">Add Customer</span>
                    </button>

                    <button onclick="scrollToServices()" class="flex flex-col items-center justify-center p-3 bg-purple-50 hover:bg-purple-100 border border-purple-200 rounded-xl transition text-center group shadow-sm hover:shadow">
                        <div class="w-10 h-10 rounded-lg bg-purple-600 text-white flex items-center justify-center text-lg mb-2 group-hover:scale-110 transition-transform">
                            <i class="fa-solid fa-laptop-code"></i>
                        </div>
                        <span class="text-xs font-semibold text-purple-900 leading-tight">New Service</span>
                    </button>

                    <button onclick="triggerQuickAction('Print Document')" class="flex flex-col items-center justify-center p-3 bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded-xl transition text-center group shadow-sm hover:shadow">
                        <div class="w-10 h-10 rounded-lg bg-blue-600 text-white flex items-center justify-center text-lg mb-2 group-hover:scale-110 transition-transform">
                            <i class="fa-solid fa-print"></i>
                        </div>
                        <span class="text-xs font-semibold text-blue-900 leading-tight">Print</span>
                    </button>

                    <button onclick="triggerQuickAction('Scan Document')" class="flex flex-col items-center justify-center p-3 bg-sky-50 hover:bg-sky-100 border border-sky-200 rounded-xl transition text-center group shadow-sm hover:shadow">
                        <div class="w-10 h-10 rounded-lg bg-sky-600 text-white flex items-center justify-center text-lg mb-2 group-hover:scale-110 transition-transform">
                            <i class="fa-solid fa-file-contract"></i>
                        </div>
                        <span class="text-xs font-semibold text-sky-900 leading-tight">Scan</span>
                    </button>

                    <button onclick="openQuickServiceModal('Online Form Fill-Up')" class="flex flex-col items-center justify-center p-3 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 rounded-xl transition text-center group shadow-sm hover:shadow">
                        <div class="w-10 h-10 rounded-lg bg-emerald-600 text-white flex items-center justify-center text-lg mb-2 group-hover:scale-110 transition-transform">
                            <i class="fa-solid fa-file-pen"></i>
                        </div>
                        <span class="text-xs font-semibold text-emerald-900 leading-tight">Online Form</span>
                    </button>

                    <button onclick="openAddTransactionModal('Income')" class="flex flex-col items-center justify-center p-3 bg-teal-50 hover:bg-teal-100 border border-teal-200 rounded-xl transition text-center group shadow-sm hover:shadow">
                        <div class="w-10 h-10 rounded-lg bg-teal-600 text-white flex items-center justify-center text-lg mb-2 group-hover:scale-110 transition-transform">
                            <i class="fa-solid fa-wallet"></i>
                        </div>
                        <span class="text-xs font-semibold text-teal-900 leading-tight">Add Income</span>
                    </button>

                    <button onclick="openAddTransactionModal('Expense')" class="flex flex-col items-center justify-center p-3 bg-rose-50 hover:bg-rose-100 border border-rose-200 rounded-xl transition text-center group shadow-sm hover:shadow">
                        <div class="w-10 h-10 rounded-lg bg-rose-600 text-white flex items-center justify-center text-lg mb-2 group-hover:scale-110 transition-transform">
                            <i class="fa-solid fa-arrow-down-short-wide"></i>
                        </div>
                        <span class="text-xs font-semibold text-rose-900 leading-tight">Add Expense</span>
                    </button>

                    <button onclick="openModal('billModal')" class="flex flex-col items-center justify-center p-3 bg-amber-50 hover:bg-amber-100 border border-amber-200 rounded-xl transition text-center group shadow-sm hover:shadow">
                        <div class="w-10 h-10 rounded-lg bg-amber-600 text-white flex items-center justify-center text-lg mb-2 group-hover:scale-110 transition-transform">
                            <i class="fa-solid fa-receipt"></i>
                        </div>
                        <span class="text-xs font-semibold text-amber-900 leading-tight">Generate Bill</span>
                    </button>

                    <button onclick="openBusinessReport()" class="flex flex-col items-center justify-center p-3 bg-slate-100 hover:bg-slate-200 border border-slate-300 rounded-xl transition text-center group shadow-sm hover:shadow">
                        <div class="w-10 h-10 rounded-lg bg-slate-700 text-white flex items-center justify-center text-lg mb-2 group-hover:scale-110 transition-transform">
                            <i class="fa-solid fa-chart-pie"></i>
                        </div>
                        <span class="text-xs font-semibold text-slate-800 leading-tight">View Reports</span>
                    </button>

                    <button onclick="openPassportPhotoModal()" class="relative flex flex-col items-center justify-center p-3 bg-fuchsia-50 hover:bg-fuchsia-100 border-2 border-fuchsia-300 rounded-xl transition text-center group shadow-sm hover:shadow ring-2 ring-fuchsia-400/30">
                        <span class="absolute -top-2 -right-1 bg-emerald-600 text-white text-[9px] font-bold px-1.5 py-0.5 rounded-full shadow-sm">Free Access</span>
                        <div class="w-10 h-10 rounded-lg bg-fuchsia-600 text-white flex items-center justify-center text-lg mb-2 group-hover:scale-110 transition-transform">
                            <i class="fa-solid fa-id-badge"></i>
                        </div>
                        <span class="text-xs font-semibold text-fuchsia-900 leading-tight">Passport Photo</span>
                    </button>

                    <button onclick="openImageEditorModal()" class="relative flex flex-col items-center justify-center p-3 bg-cyan-50 hover:bg-cyan-100 border-2 border-cyan-300 rounded-xl transition text-center group shadow-sm hover:shadow ring-2 ring-cyan-400/30">
                        <span class="absolute -top-2 -right-1 bg-emerald-600 text-white text-[9px] font-bold px-1.5 py-0.5 rounded-full shadow-sm">Free Access</span>
                        <div class="w-10 h-10 rounded-lg bg-cyan-600 text-white flex items-center justify-center text-lg mb-2 group-hover:scale-110 transition-transform">
                            <i class="fa-solid fa-image"></i>
                        </div>
                        <span class="text-xs font-semibold text-cyan-900 leading-tight">Photo &amp; Signature</span>
                    </button>

                    <button onclick="openPdfToolsModal()" class="relative flex flex-col items-center justify-center p-3 bg-rose-50 hover:bg-rose-100 border-2 border-rose-300 rounded-xl transition text-center group shadow-sm hover:shadow ring-2 ring-rose-400/30">
                        <span class="absolute -top-2 -right-1 bg-emerald-600 text-white text-[9px] font-bold px-1.5 py-0.5 rounded-full shadow-sm">Free Access</span>
                        <div class="w-10 h-10 rounded-lg bg-rose-600 text-white flex items-center justify-center text-lg mb-2 group-hover:scale-110 transition-transform">
                            <i class="fa-solid fa-file-pdf"></i>
                        </div>
                        <span class="text-xs font-semibold text-rose-900 leading-tight">PDF Tools</span>
                    </button>
                </div>
                </div>
            </section>

            <!-- 2. TODAY'S OVERVIEW CARDS -->
            <section id="performance-section" data-dashboard-panel class="dashboard-panel hidden relative z-10 mb-8">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-lg font-bold text-gray-800 flex items-center gap-2">
                        <i class="fa-solid fa-chart-line text-purple-600"></i> Today's Performance Overview
                    </h3>
                    <span class="text-xs font-semibold text-purple-600 bg-purple-100 px-2.5 py-1 rounded-full">Real-time Stats</span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-7 gap-4">
                    <!-- Today's Customers -->
                    <div class="bg-white p-4 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md hover:-translate-y-1 transition duration-200">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Today's Customers</span>
                            <div class="w-9 h-9 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center text-base">
                                <i class="fa-solid fa-users"></i>
                            </div>
                        </div>
                        <div class="text-2xl font-bold text-gray-900" id="stat-customers-count">â€”</div>
                        <p class="text-[11px] text-gray-400 font-medium mt-1 flex items-center gap-1">
                            <i class="fa-solid fa-lock text-xs"></i> Login to view
                        </p>
                    </div>

                    <!-- Today's Income -->
                    <div class="bg-white p-4 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md hover:-translate-y-1 transition duration-200">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Today's Income</span>
                            <div class="w-9 h-9 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center text-base">
                                <i class="fa-solid fa-indian-rupee-sign"></i>
                            </div>
                        </div>
                        <div class="text-2xl font-bold text-emerald-600" id="stat-income-amount">â‚¹0</div>
                        <p class="text-[11px] text-gray-400 mt-1 flex items-center gap-1">
                            <i class="fa-solid fa-lock text-xs"></i> Login to view
                        </p>
                    </div>

                    <!-- Today's Expenses -->
                    <div class="bg-white p-4 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md hover:-translate-y-1 transition duration-200">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Today's Expenses</span>
                            <div class="w-9 h-9 rounded-xl bg-rose-100 text-rose-600 flex items-center justify-center text-base">
                                <i class="fa-solid fa-receipt"></i>
                            </div>
                        </div>
                        <div class="text-2xl font-bold text-rose-600" id="stat-expense-amount">â‚¹0</div>
                        <p class="text-[11px] text-gray-400 mt-1 flex items-center gap-1">
                            <i class="fa-solid fa-lock text-xs"></i> Login to view
                        </p>
                    </div>

                    <!-- Today's Profit -->
                    <div class="bg-white p-4 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md hover:-translate-y-1 transition duration-200">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Today's Profit</span>
                            <div class="w-9 h-9 rounded-xl bg-purple-100 text-purple-600 flex items-center justify-center text-base">
                                <i class="fa-solid fa-piggy-bank"></i>
                            </div>
                        </div>
                        <div class="text-2xl font-bold text-purple-600" id="stat-profit-amount">â‚¹0</div>
                        <p class="text-[11px] text-gray-400 font-medium mt-1 flex items-center gap-1">
                            <i class="fa-solid fa-lock text-xs"></i> Login to view
                        </p>
                    </div>

                    <!-- Pending Services -->
                    <div class="bg-white p-4 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md hover:-translate-y-1 transition duration-200">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Pending Services</span>
                            <div class="w-9 h-9 rounded-xl bg-amber-100 text-amber-600 flex items-center justify-center text-base">
                                <i class="fa-solid fa-clock-rotate-left"></i>
                            </div>
                        </div>
                        <div class="text-2xl font-bold text-amber-600" id="stat-pending-count">â€”</div>
                        <p class="text-[11px] text-gray-400 font-medium mt-1 flex items-center gap-1">
                            <i class="fa-solid fa-lock text-xs"></i> Login to view
                        </p>
                    </div>

                    <!-- Completed Services -->
                    <div class="bg-white p-4 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md hover:-translate-y-1 transition duration-200">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Lifetime Tasks</span>
                            <div class="w-9 h-9 rounded-xl bg-teal-100 text-teal-600 flex items-center justify-center text-base">
                                <i class="fa-solid fa-circle-check"></i>
                            </div>
                        </div>
                        <div class="text-2xl font-bold text-teal-600" id="stat-completed-count">â€”</div>
                        <p class="text-[11px] text-gray-400 font-medium mt-1 flex items-center gap-1">
                            <i class="fa-solid fa-lock text-xs"></i> Login to view
                        </p>
                    </div>

                    <!-- Lifetime Earnings -->
                    <div class="bg-white p-4 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md hover:-translate-y-1 transition duration-200">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Lifetime Earnings</span>
                            <div class="w-9 h-9 rounded-xl bg-indigo-100 text-indigo-600 flex items-center justify-center text-base">
                                <i class="fa-solid fa-wallet"></i>
                            </div>
                        </div>
                        <div class="text-2xl font-bold text-indigo-600" id="stat-lifetime-earnings">â‚¹0</div>
                        <p class="text-[11px] text-gray-400 font-medium mt-1 flex items-center gap-1">
                            <i class="fa-solid fa-lock text-xs"></i> Login to view
                        </p>
                    </div>
