    <!-- PAN APPLICATION WORKSPACE -->
    <div id="panApplicationModal" class="fixed inset-0 z-[70] hidden bg-slate-950/70 p-3 backdrop-blur-sm sm:p-5" role="dialog" aria-modal="true" aria-labelledby="pan-application-title">
        <div class="mx-auto flex h-full max-w-5xl flex-col overflow-hidden rounded-2xl bg-white shadow-2xl">
            <div class="flex items-start justify-between gap-4 border-b border-emerald-100 bg-gradient-to-r from-emerald-700 to-teal-700 px-5 py-4 text-white sm:px-6">
                <div>
                    <div class="mb-1 flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.16em] text-emerald-100">
                        <i class="fa-solid fa-shield-halved"></i> Secure application preparation
                    </div>
                    <h3 id="pan-application-title" class="text-lg font-bold sm:text-xl">PAN Card Application</h3>
                    <p class="mt-1 text-xs text-emerald-50">Prepare, save, and continue your application on an authorised PAN portal.</p>
                </div>
                <button id="pan-application-close" type="button" class="rounded-lg p-2 text-emerald-100 transition hover:bg-white/15 hover:text-white" aria-label="Close PAN application">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <div class="flex-1 overflow-y-auto p-4 sm:p-6">
                <div class="mb-5 rounded-xl border border-amber-200 bg-amber-50 px-3 py-2.5 text-xs leading-relaxed text-amber-900">
                    <i class="fa-solid fa-circle-info mr-1 text-amber-600"></i>
                    This workspace prepares the application for the customer. Aadhaar OTP, payment, captcha, and final submission are completed only on the official UTIITSL or Protean portal. Never enter an Aadhaar number, OTP, card number, or UPI PIN here.
                </div>

                <div class="mb-6 grid grid-cols-4 gap-1.5 sm:gap-3" aria-label="PAN application steps">
                    <button type="button" data-pan-step-target="1" class="pan-step-indicator rounded-xl border border-emerald-600 bg-emerald-600 px-2 py-2 text-left text-white transition">
                        <span class="block text-[10px] font-bold uppercase tracking-wide opacity-80">Step 1</span>
                        <span class="block text-[11px] font-semibold sm:text-xs">Service</span>
                    </button>
                    <button type="button" data-pan-step-target="2" class="pan-step-indicator rounded-xl border border-gray-200 bg-white px-2 py-2 text-left text-gray-500 transition">
                        <span class="block text-[10px] font-bold uppercase tracking-wide">Step 2</span>
                        <span class="block text-[11px] font-semibold sm:text-xs">Applicant</span>
                    </button>
                    <button type="button" data-pan-step-target="3" class="pan-step-indicator rounded-xl border border-gray-200 bg-white px-2 py-2 text-left text-gray-500 transition">
                        <span class="block text-[10px] font-bold uppercase tracking-wide">Step 3</span>
                        <span class="block text-[11px] font-semibold sm:text-xs">Address &amp; docs</span>
                    </button>
                    <button type="button" data-pan-step-target="4" class="pan-step-indicator rounded-xl border border-gray-200 bg-white px-2 py-2 text-left text-gray-500 transition">
                        <span class="block text-[10px] font-bold uppercase tracking-wide">Step 4</span>
                        <span class="block text-[11px] font-semibold sm:text-xs">Review &amp; submit</span>
                    </button>
                </div>

                <form id="pan-application-form" novalidate>
                    <div id="pan-application-alert" class="mb-4 hidden rounded-xl px-3 py-2.5 text-xs" role="alert"></div>

                    <section data-pan-step="1" class="pan-application-step space-y-4">
                        <div>
                            <h4 class="text-base font-bold text-gray-900">Choose the PAN service</h4>
                            <p class="mt-1 text-xs text-gray-500">This form currently supports individual resident Indian applicants. Choose the service that matches the customerâ€™s request.</p>
                        </div>
                        <div class="grid gap-4 md:grid-cols-2">
                            <div>
                                <label for="pan-application-type" class="mb-1 block text-xs font-semibold text-gray-700">Application type <span class="text-rose-600">*</span></label>
                                <select id="pan-application-type" required class="w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-200">
                                    <option value="new">New PAN card</option>
                                    <option value="correction">Change / correction in PAN</option>
                                    <option value="reprint">Reprint PAN card</option>
                                </select>
                            </div>
                            <div>
                                <label for="pan-application-provider" class="mb-1 block text-xs font-semibold text-gray-700">Official provider <span class="text-rose-600">*</span></label>
                                <select id="pan-application-provider" required class="w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-200">
                                    <option value="uti">UTIITSL PAN Services</option>
                                    <option value="protean">Protean PAN Services</option>
                                </select>
                            </div>
                        </div>
                        <div id="pan-existing-number-group" class="hidden rounded-xl border border-blue-200 bg-blue-50 p-3">
                            <label for="pan-existing-number" class="mb-1 block text-xs font-semibold text-blue-900">Existing PAN number <span class="text-rose-600">*</span></label>
                            <input id="pan-existing-number" type="text" maxlength="10" autocomplete="off" placeholder="ABCDE1234F" class="mb-0 w-full rounded-lg border border-blue-200 bg-white p-2.5 font-mono text-sm uppercase tracking-wider focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200">
                            <p class="mt-1 text-[11px] text-blue-800">Required for correction or reprint. Store only the PAN needed for this customerâ€™s request.</p>
                        </div>
                        <div class="grid gap-4 md:grid-cols-2">
                            <div>
                                <label for="pan-contact-mobile" class="mb-1 block text-xs font-semibold text-gray-700">Customer mobile number <span class="text-rose-600">*</span></label>
                                <input id="pan-contact-mobile" type="tel" inputmode="numeric" maxlength="10" pattern="[0-9]{10}" autocomplete="tel" placeholder="10-digit mobile number" required class="mb-0 w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-200">
                            </div>
                            <div>
                                <label for="pan-contact-email" class="mb-1 block text-xs font-semibold text-gray-700">Customer email <span class="text-rose-600">*</span></label>
                                <input id="pan-contact-email" type="email" autocomplete="email" placeholder="customer@example.com" required class="mb-0 w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-200">
                            </div>
                        </div>
                        <div class="rounded-xl border border-emerald-100 bg-emerald-50 p-3 text-xs text-emerald-900">
                            <div class="font-bold"><i class="fa-solid fa-lightbulb mr-1"></i> Before you begin</div>
                            <p class="mt-1">Confirm that the customer does not already hold a PAN before starting a new application. Use the exact spelling and date of birth shown on the supporting documents.</p>
                        </div>
                    </section>

                    <section data-pan-step="2" class="pan-application-step hidden space-y-4">
                        <div>
                            <h4 class="text-base font-bold text-gray-900">Applicant details</h4>
                            <p class="mt-1 text-xs text-gray-500">Enter the customerâ€™s legal details exactly as they appear on the identity proof.</p>
                        </div>
                        <div class="grid gap-4 sm:grid-cols-3">
                            <div>
                                <label for="pan-title" class="mb-1 block text-xs font-semibold text-gray-700">Title <span class="text-rose-600">*</span></label>
                                <select id="pan-title" required class="w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-200">
                                    <option value="Shri">Shri</option>
                                    <option value="Smt">Smt</option>
                                    <option value="Kumari">Kumari</option>
                                </select>
                            </div>
                            <div>
                                <label for="pan-first-name" class="mb-1 block text-xs font-semibold text-gray-700">First name <span class="text-rose-600">*</span></label>
                                <input id="pan-first-name" type="text" maxlength="60" autocomplete="given-name" required class="mb-0 w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm uppercase focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-200">
                            </div>
                            <div>
                                <label for="pan-last-name" class="mb-1 block text-xs font-semibold text-gray-700">Last name / surname <span class="text-rose-600">*</span></label>
                                <input id="pan-last-name" type="text" maxlength="60" autocomplete="family-name" required class="mb-0 w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm uppercase focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-200">
                            </div>
                        </div>
                        <div class="grid gap-4 md:grid-cols-3">
                            <div>
                                <label for="pan-middle-name" class="mb-1 block text-xs font-semibold text-gray-700">Middle name</label>
                                <input id="pan-middle-name" type="text" maxlength="60" autocomplete="additional-name" class="mb-0 w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm uppercase focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-200">
                            </div>
                            <div>
                                <label for="pan-dob" class="mb-1 block text-xs font-semibold text-gray-700">Date of birth <span class="text-rose-600">*</span></label>
                                <input id="pan-dob" type="date" required class="mb-0 w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-200">
                            </div>
                            <div>
                                <label for="pan-gender" class="mb-1 block text-xs font-semibold text-gray-700">Gender <span class="text-rose-600">*</span></label>
                                <select id="pan-gender" required class="w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-200">
                                    <option value="">Select gender</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                    <option value="Transgender">Transgender</option>
                                </select>
                            </div>
                        </div>
                        <div class="grid gap-4 md:grid-cols-2">
                            <div>
                                <label for="pan-father-name" class="mb-1 block text-xs font-semibold text-gray-700">Fatherâ€™s full name <span class="text-rose-600">*</span></label>
                                <input id="pan-father-name" type="text" maxlength="120" required class="mb-0 w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm uppercase focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-200">
                            </div>
                            <div>
                                <label for="pan-name-on-card" class="mb-1 block text-xs font-semibold text-gray-700">Name to print on PAN card <span class="text-rose-600">*</span></label>
                                <input id="pan-name-on-card" type="text" maxlength="85" required placeholder="Auto-filled from applicant name" class="mb-0 w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm uppercase focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-200">
                                <p class="mt-1 text-[11px] text-gray-500">You can edit this if the official portal requires a different display name.</p>
                            </div>
                        </div>
                    </section>

                    <section data-pan-step="3" class="pan-application-step hidden space-y-4">
                        <div>
                            <h4 class="text-base font-bold text-gray-900">Communication address &amp; documents</h4>
                            <p class="mt-1 text-xs text-gray-500">Upload only documents that the official portal asks for. Files are kept in this operatorâ€™s protected workspace for the application.</p>
                        </div>
                        <div class="grid gap-4 md:grid-cols-2">
                            <div class="md:col-span-2">
                                <label for="pan-address-line1" class="mb-1 block text-xs font-semibold text-gray-700">Address line 1 <span class="text-rose-600">*</span></label>
                                <input id="pan-address-line1" type="text" maxlength="120" autocomplete="address-line1" required class="mb-0 w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-200">
                            </div>
                            <div class="md:col-span-2">
                                <label for="pan-address-line2" class="mb-1 block text-xs font-semibold text-gray-700">Address line 2</label>
                                <input id="pan-address-line2" type="text" maxlength="120" autocomplete="address-line2" class="mb-0 w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-200">
                            </div>
                            <div>
                                <label for="pan-city" class="mb-1 block text-xs font-semibold text-gray-700">City / district <span class="text-rose-600">*</span></label>
                                <input id="pan-city" type="text" maxlength="60" autocomplete="address-level2" required class="mb-0 w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-200">
                            </div>
                            <div>
                                <label for="pan-state" class="mb-1 block text-xs font-semibold text-gray-700">State / UT <span class="text-rose-600">*</span></label>
                                <input id="pan-state" type="text" maxlength="60" autocomplete="address-level1" required class="mb-0 w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-200">
                            </div>
                            <div>
                                <label for="pan-pincode" class="mb-1 block text-xs font-semibold text-gray-700">PIN code <span class="text-rose-600">*</span></label>
                                <input id="pan-pincode" type="text" inputmode="numeric" maxlength="6" pattern="[0-9]{6}" autocomplete="postal-code" required class="mb-0 w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-200">
                            </div>
                            <div>
                                <label for="pan-aadhaar-last4" class="mb-1 block text-xs font-semibold text-gray-700">Aadhaar last 4 digits <span class="text-gray-400">(optional)</span></label>
                                <input id="pan-aadhaar-last4" type="text" inputmode="numeric" maxlength="4" pattern="[0-9]{4}" autocomplete="off" placeholder="Never enter full Aadhaar number" class="mb-0 w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-200">
                            </div>
                        </div>

                        <div class="rounded-xl border border-gray-200 bg-gray-50 p-4">
                            <div class="mb-3 flex flex-wrap items-start justify-between gap-2">
                                <div>
                                    <h5 class="text-sm font-bold text-gray-800"><i class="fa-solid fa-file-arrow-up mr-1 text-emerald-600"></i> Application files</h5>
                                    <p class="mt-0.5 text-[11px] text-gray-500">JPG, PNG, WEBP, or PDF Â· maximum 5 MB each. Photo and signature are optional until the official provider confirms the route.</p>
                                </div>
                                <span class="rounded-full bg-white px-2 py-1 text-[10px] font-semibold text-gray-500 ring-1 ring-gray-200">Optional uploads</span>
                            </div>
                            <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                                <label class="block rounded-lg border border-dashed border-gray-300 bg-white p-3 transition hover:border-emerald-400">
                                    <span class="block text-xs font-semibold text-gray-700">Applicant photo</span>
                                    <input id="pan-doc-photo" data-pan-document="photo" type="file" accept="image/jpeg,image/png,image/webp" class="mt-2 block w-full text-[11px] text-gray-600 file:mr-2 file:rounded-md file:border-0 file:bg-emerald-600 file:px-2 file:py-1.5 file:text-[11px] file:font-semibold file:text-white hover:file:bg-emerald-700">
                                    <span data-pan-file-name="photo" class="mt-1 block truncate text-[10px] text-gray-400">No file selected</span>
                                </label>
                                <label class="block rounded-lg border border-dashed border-gray-300 bg-white p-3 transition hover:border-emerald-400">
                                    <span class="block text-xs font-semibold text-gray-700">Signature</span>
                                    <input id="pan-doc-signature" data-pan-document="signature" type="file" accept="image/jpeg,image/png,image/webp" class="mt-2 block w-full text-[11px] text-gray-600 file:mr-2 file:rounded-md file:border-0 file:bg-emerald-600 file:px-2 file:py-1.5 file:text-[11px] file:font-semibold file:text-white hover:file:bg-emerald-700">
                                    <span data-pan-file-name="signature" class="mt-1 block truncate text-[10px] text-gray-400">No file selected</span>
                                </label>
                                <label class="block rounded-lg border border-dashed border-gray-300 bg-white p-3 transition hover:border-emerald-400">
                                    <span class="block text-xs font-semibold text-gray-700">Supporting proof</span>
                                    <input id="pan-doc-supporting" data-pan-document="supportingProof" type="file" accept="image/jpeg,image/png,image/webp,application/pdf" class="mt-2 block w-full text-[11px] text-gray-600 file:mr-2 file:rounded-md file:border-0 file:bg-emerald-600 file:px-2 file:py-1.5 file:text-[11px] file:font-semibold file:text-white hover:file:bg-emerald-700">
                                    <span data-pan-file-name="supportingProof" class="mt-1 block truncate text-[10px] text-gray-400">No file selected</span>
                                </label>
                            </div>
                        </div>
                    </section>

                    <section data-pan-step="4" class="pan-application-step hidden space-y-4">
                        <div>
                            <h4 class="text-base font-bold text-gray-900">Review, save &amp; continue</h4>
                            <p class="mt-1 text-xs text-gray-500">Review the prepared information before opening the authorised PAN provider website.</p>
                        </div>
                        <div id="pan-application-review" class="rounded-xl border border-gray-200 bg-slate-50 p-4 text-xs text-gray-700"></div>
                        <div class="grid gap-4 md:grid-cols-2">
                            <div>
                                <label for="pan-official-acknowledgement" class="mb-1 block text-xs font-semibold text-gray-700">Official acknowledgement number <span class="text-gray-400">(after final submission)</span></label>
                                <input id="pan-official-acknowledgement" type="text" maxlength="60" autocomplete="off" placeholder="Enter after official portal submission" class="mb-0 w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm uppercase focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-200">
                            </div>
                            <div class="rounded-xl border border-blue-100 bg-blue-50 p-3 text-xs text-blue-900">
                                <div class="font-bold"><i class="fa-solid fa-arrow-up-right-from-square mr-1"></i> What happens next</div>
                                <p class="mt-1">Save this application, then open the official provider in a new tab. Complete identity checks, captcha and payment there; return here to save the acknowledgement number.</p>
                            </div>
                        </div>
                        <label class="flex items-start gap-2 rounded-xl border border-gray-200 p-3 text-xs text-gray-700">
                            <input id="pan-single-pan-consent" type="checkbox" class="mt-0.5 h-4 w-4 accent-emerald-600">
                            <span>I confirm that this customer is applying for only one PAN and has authorised me to prepare the application details.</span>
                        </label>
                        <label class="flex items-start gap-2 rounded-xl border border-gray-200 p-3 text-xs text-gray-700">
                            <input id="pan-data-consent" type="checkbox" class="mt-0.5 h-4 w-4 accent-emerald-600">
                            <span>I understand that the official provider may ask for additional documents or verification. No OTP, payment credential, or Aadhaar number is collected in this workspace.</span>
                        </label>
                        <div class="flex flex-wrap gap-x-4 gap-y-2 text-xs font-semibold">
                            <a id="pan-track-link" href="https://www.trackpan.utiitsl.com/PANONLINE/" target="_blank" rel="noopener noreferrer" class="text-emerald-700 hover:text-emerald-900"><i class="fa-solid fa-location-dot mr-1"></i>Track PAN status</a>
                            <a href="https://www.pan.utiitsl.com/" target="_blank" rel="noopener noreferrer" class="text-emerald-700 hover:text-emerald-900"><i class="fa-solid fa-circle-question mr-1"></i>Official PAN help</a>
                        </div>
                    </section>
                </form>

                <div class="mt-6 rounded-xl border border-gray-200 bg-white p-4">
                    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
                        <div>
                            <h4 class="text-sm font-bold text-gray-900"><i class="fa-solid fa-folder-open mr-1 text-emerald-600"></i>Saved PAN applications</h4>
                            <p class="mt-0.5 text-[11px] text-gray-500">Drafts and acknowledgements saved to this operator account.</p>
                        </div>
                        <span id="pan-application-count" class="rounded-full bg-emerald-50 px-2 py-1 text-[10px] font-bold text-emerald-700">0 applications</span>
                    </div>
                    <div id="pan-application-list" class="space-y-2"></div>
                </div>
            </div>

            <div class="flex flex-col-reverse gap-2 border-t border-gray-200 bg-white px-4 py-3 sm:flex-row sm:items-center sm:justify-between sm:px-6">
                <button id="pan-previous-step" type="button" class="hidden rounded-lg border border-gray-300 px-3 py-2 text-xs font-semibold text-gray-700 transition hover:bg-gray-50"><i class="fa-solid fa-arrow-left mr-1"></i>Back</button>
                <div class="flex flex-1 flex-wrap justify-end gap-2">
                    <button id="pan-save-draft" type="button" class="rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2 text-xs font-semibold text-emerald-800 transition hover:bg-emerald-100"><i class="fa-regular fa-floppy-disk mr-1"></i>Save draft</button>
                    <button id="pan-next-step" type="button" class="rounded-lg bg-emerald-600 px-3 py-2 text-xs font-semibold text-white transition hover:bg-emerald-700">Continue <i class="fa-solid fa-arrow-right ml-1"></i></button>
                    <button id="pan-open-official" type="button" class="hidden rounded-lg bg-teal-700 px-3 py-2 text-xs font-semibold text-white transition hover:bg-teal-800"><i class="fa-solid fa-arrow-up-right-from-square mr-1"></i>Save &amp; open official portal</button>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL 2: ACCOUNT PROFILE -->
    <div id="profileModal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[60] flex items-center justify-center p-4 hidden" role="dialog" aria-modal="true" aria-labelledby="profile-modal-title">
        <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-gray-100 relative max-h-[90vh] overflow-y-auto">
            <button type="button" onclick="closeProfileModal()" class="absolute top-4 right-4 text-gray-400 hover:text-gray-700 text-lg" aria-label="Close profile">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <h3 id="profile-modal-title" class="text-lg font-bold text-gray-900 mb-1 flex items-center gap-2">
                <i class="fa-solid fa-id-card text-purple-600"></i> My Profile
            </h3>
            <p class="text-xs text-gray-500 mb-4">Your account details for this CSC dashboard.</p>

            <form id="profile-form" onsubmit="handleProfileSubmit(event)">
                <div id="profile-form-alert" class="hidden mb-3 rounded-lg px-3 py-2 text-xs" role="alert"></div>
                <div class="space-y-3 text-left">
                    <div class="flex items-center gap-3 rounded-xl border border-purple-100 bg-purple-50 p-3">
                        <img id="profile-photo-preview" src="https://placehold.co/96x96/5c43cd/ffffff?text=Profile" alt="Profile photo preview" class="h-16 w-16 rounded-full object-cover border-2 border-white shadow-sm bg-white" onerror="this.src='https://placehold.co/96x96/5c43cd/ffffff?text=Profile'">
                        <div class="min-w-0 flex-1">
                            <label for="profile-photo-file" class="inline-flex cursor-pointer items-center gap-1.5 rounded-lg bg-purple-600 px-3 py-2 text-xs font-semibold text-white transition hover:bg-purple-700">
                                <i class="fa-solid fa-camera"></i> Upload Photo
                            </label>
                            <input id="profile-photo-file" type="file" accept="image/jpeg,image/png,image/webp" class="hidden" onchange="profilePhotoSelected(event)">
                            <p id="profile-photo-file-name" class="mt-1.5 truncate text-[11px] text-purple-700">JPG, PNG or WEBP Â· Maximum 5 MB</p>
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-700 mb-1">Full Name</label>
                        <input id="profile-name" type="text" readonly class="!mb-0 !p-2 text-xs bg-gray-100 border border-gray-200 rounded-lg text-gray-600 cursor-not-allowed">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-700 mb-1">Mobile Number</label>
                        <input id="profile-mobile" type="tel" readonly class="!mb-0 !p-2 text-xs bg-gray-100 border border-gray-200 rounded-lg text-gray-600 cursor-not-allowed">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-700 mb-1">Email Address</label>
                        <input id="profile-email" type="email" autocomplete="email" required class="!mb-0 !p-2 text-xs bg-gray-50 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500">
                        <p id="profile-email-help" class="hidden mt-1 text-[11px] text-amber-700"></p>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-700 mb-1">Address</label>
                        <textarea id="profile-address" rows="3" maxlength="500" placeholder="Enter your complete address" class="w-full !mb-0 !p-2 text-xs bg-gray-50 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 resize-y"></textarea>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-700 mb-1">Service Center / Server Name</label>
                        <input id="profile-center-name" type="text" maxlength="80" placeholder="e.g. Akshay Digital Common Service Centre" class="!mb-0 !p-2 text-xs bg-gray-50 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500">
                        <p class="mt-1 text-[11px] text-gray-500">This name will appear in the dashboard banner.</p>
                    </div>
                    <div class="rounded-lg border border-amber-200 bg-amber-50 p-3">
                        <label class="block text-xs font-semibold text-amber-900 mb-1">Current Password <span class="font-normal text-amber-700">(only when changing email)</span></label>
                        <input id="profile-current-password" type="password" autocomplete="current-password" placeholder="Required to confirm a new email" class="!mb-0 !p-2 text-xs bg-white border border-amber-200 rounded-lg focus:ring-2 focus:ring-amber-500">
                    </div>
                </div>
                <div class="mt-5 flex gap-2">
                    <button type="button" onclick="closeProfileModal()" class="w-1/2 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold rounded-lg text-xs">Cancel</button>
                    <button type="submit" id="profile-save-btn" class="w-1/2 py-2 bg-purple-600 hover:bg-purple-700 text-white font-semibold rounded-lg text-xs">Save Changes</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL 3: GENERATE BILL / INVOICE MODAL -->
    <div id="billModal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-gray-100 relative max-h-[90vh] overflow-y-auto">
            <button onclick="closeModal('billModal')" class="absolute top-4 right-4 text-gray-400 hover:text-gray-700 text-lg">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <div id="printable-invoice">
                <div class="text-center pb-3 border-b border-gray-200 mb-4">
                    <h3 class="text-base font-bold text-purple-800">Akshay Santra CSC &amp; Cyber Cafe</h3>
                    <p class="text-[11px] text-gray-500">Gopalpur, Paschim Medinipur, WB | Helpline: +91 98000 00000</p>
                    <div class="inline-block bg-purple-100 text-purple-800 text-[10px] font-bold px-2 py-0.5 rounded mt-1">OFFICIAL RECEIPT</div>
                </div>

                <div class="space-y-3 mb-4 text-xs">
                    <div class="flex justify-between">
                        <span class="text-gray-500">Receipt No: <strong class="text-gray-800" id="inv-no">#INV-9921</strong></span>
                        <span class="text-gray-500">Date: <strong class="text-gray-800" id="inv-date">15 Sep 2026</strong></span>
                    </div>
                    <div>
                        <label class="block text-[11px] font-semibold text-gray-700 mb-1">Customer Name:</label>
                        <input type="text" id="bill-cust-name" value="Sourav Ghosh" class="!mb-0 !p-1.5 text-xs bg-gray-50 border border-gray-300 rounded">
                    </div>
                    <div>
                        <label class="block text-[11px] font-semibold text-gray-700 mb-1">Service Rendered:</label>
                        <input type="text" id="bill-service-name" value="Online Form Fill-Up & Printing" class="!mb-0 !p-1.5 text-xs bg-gray-50 border border-gray-300 rounded">
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="block text-[11px] font-semibold text-gray-700 mb-1">Service Charges (â‚¹):</label>
                            <input type="number" id="bill-amount" value="150" oninput="updateBillTotal()" class="!mb-0 !p-1.5 text-xs bg-gray-50 border border-gray-300 rounded">
                        </div>
                        <div>
                            <label class="block text-[11px] font-semibold text-gray-700 mb-1">GST/Govt Fee (â‚¹):</label>
                            <input type="number" id="bill-gst" value="0" oninput="updateBillTotal()" class="!mb-0 !p-1.5 text-xs bg-gray-50 border border-gray-300 rounded">
                        </div>
                    </div>
                    <div class="bg-purple-50 p-3 rounded-lg border border-purple-200 flex justify-between items-center font-bold text-purple-900 text-sm">
                        <span>Grand Total Payable:</span>
                        <span id="bill-total-disp">â‚¹150.00</span>
                    </div>
                </div>
            </div>

            <div class="flex gap-2">
                <button onclick="printInvoice()" class="w-full py-2 bg-purple-600 hover:bg-purple-700 text-white font-semibold rounded-lg text-xs flex items-center justify-center gap-1.5">
                    <i class="fa-solid fa-print"></i> Print Receipt / Download PDF
                </button>
            </div>
        </div>
    </div>

    <!-- MODAL 3: PASSPORT PHOTO PRINT STUDIO -->
    <div id="passportPhotoModal" class="fixed inset-0 bg-slate-950/70 backdrop-blur-sm z-[60] flex items-center justify-center p-2 sm:p-4 hidden">
        <div class="pps-dialog">

            <!-- â•â•â• HEADER â•â•â• -->
            <div class="pps-header">
                <div class="flex items-start justify-between gap-3">
                    <div>
                        <h3 class="text-base font-bold text-gray-900 flex items-center gap-2">
                            <span class="w-8 h-8 rounded-xl bg-fuchsia-100 text-fuchsia-700 flex items-center justify-center text-sm"><i class="fa-solid fa-id-badge"></i></span>
                            Passport Photo Print Studio
                        </h3>
                        <p class="text-[11px] text-gray-400 mt-0.5">Upload Â· Edit Â· Print A4 photo sheet</p>
                    </div>
                    <button type="button" onclick="closePassportPhotoModal()" class="text-gray-400 hover:text-gray-700 text-lg p-1 transition" aria-label="Close passport photo studio">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>

                <!-- 3-Step indicator -->
                <div class="pps-step-bar">
                    <div class="pps-step is-active" id="pps-step-1">
                        <span class="pps-step-num" id="pps-step-num-1">1</span>
                        <span>Photo Setup</span>
                    </div>
                    <div class="pps-step-line" id="pps-line-1"></div>
                    <div class="pps-step" id="pps-step-2">
                        <span class="pps-step-num" id="pps-step-num-2">2</span>
                        <span>Crop &amp; Adjust</span>
                    </div>
                    <div class="pps-step-line" id="pps-line-2"></div>
                    <div class="pps-step" id="pps-step-3">
                        <span class="pps-step-num" id="pps-step-num-3">3</span>
                        <span>Color Edit</span>
                    </div>
                </div>
            </div>
            <!-- â•â•â• END HEADER â•â•â• -->

            <!-- â•â•â• BODY (left + right) â•â•â• -->
            <div class="pps-body" id="pps-body">

                <!-- â”€â”€â”€â”€ LEFT PANEL â”€â”€â”€â”€ -->
                <div class="pps-left">

                    <!-- Hidden file input (always present) -->
                    <input id="passport-photo-file" type="file" accept="image/jpeg,image/png,image/webp" class="hidden" onchange="passportPhotoSelected(event)">

                    <!-- State A: Upload zone (shown before photo selected) -->
                    <label for="passport-photo-file" id="pps-upload-zone" class="pps-upload-zone">
                        <div class="w-12 h-12 rounded-xl bg-fuchsia-600 text-white flex items-center justify-center text-xl mb-3">
                            <i class="fa-solid fa-cloud-arrow-up"></i>
                        </div>
                        <strong class="text-sm text-gray-900 block">Upload Customer Photo</strong>
                        <span class="text-xs text-gray-500 mt-1 block">Click to choose JPG, PNG or WEBP</span>
                        <span class="text-[10px] text-gray-400 mt-3 block leading-relaxed">Front-facing photo Â· stays in this browser only</span>
                    </label>

                    <!-- State B: Live preview (shown after photo selected) -->
                    <div id="pps-preview-panel" class="pps-preview-panel hidden">
                        <!-- Top header of preview card -->
                        <div class="pps-preview-header">
                            <span class="pps-live-pill">
                                <span class="pps-live-dot"></span> LIVE PREVIEW
                            </span>
                            <button type="button" class="pps-replace-pill-btn" onclick="triggerReplacePhoto()" title="Replace photo">
                                <i class="fa-solid fa-arrows-rotate mr-1"></i> Replace
                            </button>
                        </div>

                        <!-- Live Photo Stage -->
                        <div class="pps-preview-wrap">
                            <div id="pps-live-stage" class="pps-live-stage" style="aspect-ratio: 35 / 45;" title="Drag to reposition photo · Scroll to zoom">
                                <img id="pps-fixed-preview" class="pps-live-img select-none pointer-events-none" alt="Customer photo live preview">
                                
                                <!-- Biometric guidelines overlay -->
                                <div id="pps-live-guides" class="pps-live-guides pointer-events-none">
                                    <div class="pps-guide-border"></div>
                                    <div class="pps-guide-line-h pps-guide-eye" title="Eye line (approx 35%)"></div>
                                    <div class="pps-guide-line-h pps-guide-chin" title="Chin line (approx 75%)"></div>
                                    <div class="pps-guide-line-v" title="Center axis"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Preview Quick Tools: Guides toggle, Rotate 90°, Center -->
                        <div class="pps-preview-tools">
                            <button type="button" id="pps-toggle-guides-btn" onclick="togglePassportGuides()" class="pps-tool-btn is-active" title="Toggle Guidelines">
                                <i class="fa-solid fa-crosshairs"></i> Guides
                            </button>
                            <button type="button" onclick="rotatePassportPhoto()" class="pps-tool-btn" title="Rotate 90 degrees">
                                <i class="fa-solid fa-rotate-right"></i> Rotate
                            </button>
                            <button type="button" onclick="resetPassportCrop()" class="pps-tool-btn" title="Center photo">
                                <i class="fa-solid fa-arrows-to-dot"></i> Center
                            </button>
                        </div>

                        <!-- Metadata details below photo -->
                        <div class="pps-preview-meta">
                            <div class="pps-preview-filename" id="pps-preview-filename">photo.jpg</div>
                            <div class="pps-preview-badge" id="pps-preview-badge">
                                <i class="fa-solid fa-check-circle"></i> <span id="pps-badge-text">Photo Ready</span>
                            </div>
                            <div id="pps-backdrop-indicator" class="text-[11px] text-gray-500 mt-1 flex items-center justify-center gap-1.5">
                                <span>Backdrop:</span>
                                <span id="pps-backdrop-swatch" class="inline-block w-2.5 h-2.5 rounded-full border border-gray-300 bg-white shadow-xs"></span>
                                <span id="pps-backdrop-name" class="font-medium text-gray-700">Original</span>
                            </div>
                        </div>
                    </div>

                </div>
                <!-- â”€â”€â”€â”€ END LEFT PANEL â”€â”€â”€â”€ -->

                <!-- â”€â”€â”€â”€ RIGHT PANEL â”€â”€â”€â”€ -->
                <div class="pps-right" id="pps-right-panel">

                    <!-- SLIDES VIEWPORT -->
                    <div class="pps-slides-viewport" id="pps-slides-viewport">
                        <div class="pps-slides-track" id="pps-slides-track">

                            <!-- â•â•â•â•â•â• SLIDE 1: PHOTO SETUP â•â•â•â•â•â• -->
                            <div class="pps-slide" id="pps-slide-1">
                                <div class="pps-slide-title">
                                    <span class="w-7 h-7 rounded-lg bg-fuchsia-100 text-fuchsia-700 flex items-center justify-center text-xs"><i class="fa-solid fa-sliders"></i></span>
                                    Photo Setup
                                </div>

                                <div class="space-y-4">
                                    <!-- Passport Photo Size -->
                                    <div>
                                        <label for="passport-photo-size" class="block text-xs font-bold text-gray-700 mb-1.5">
                                            <i class="fa-solid fa-ruler-combined text-fuchsia-500 mr-1"></i>Passport Photo Size
                                        </label>
                                        <select id="passport-photo-size" onchange="handlePassportPhotoSizeChange()" class="w-full p-2.5 text-sm bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-fuchsia-500 focus:outline-none">
                                            <optgroup label="Indian Documents">
                                                <option value="35x45" data-label="Indian Passport (35 Ã— 45 mm)" selected>ðŸ‡®ðŸ‡³ Indian Passport / Visa â€” 35 Ã— 45 mm</option>
                                                <option value="25x35" data-label="Aadhaar / Voter ID (25 Ã— 35 mm)">ðŸªª Aadhaar / Voter ID â€” 25 Ã— 35 mm</option>
                                                <option value="35x35" data-label="PAN Card (35 Ã— 35 mm)">ðŸ’³ PAN Card â€” 35 Ã— 35 mm</option>
                                                <option value="30x40" data-label="Driving Licence (30 Ã— 40 mm)">ðŸš— Driving Licence â€” 30 Ã— 40 mm</option>
                                                <option value="30x35" data-label="School / College ID (30 Ã— 35 mm)">ðŸŽ“ School / College ID â€” 30 Ã— 35 mm</option>
                                            </optgroup>
                                            <optgroup label="International">
                                                <option value="51x51" data-label="Visa / US Passport (2 Ã— 2 inch)">ðŸ‡ºðŸ‡¸ US / Canada / Schengen â€” 51 Ã— 51 mm (2Ã—2 in)</option>
                                                <option value="35x45" data-label="UK Passport (35 Ã— 45 mm)">ðŸ‡¬ðŸ‡§ UK Passport â€” 35 Ã— 45 mm</option>
                                                <option value="35x45" data-label="EU Passport (35 Ã— 45 mm)">ðŸ‡ªðŸ‡º EU Passport â€” 35 Ã— 45 mm</option>
                                                <option value="33x48" data-label="UAE / Dubai Visa (33 Ã— 48 mm)">ðŸ‡¦ðŸ‡ª UAE Visa â€” 33 Ã— 48 mm</option>
                                                <option value="40x60" data-label="Australia Visa (40 Ã— 60 mm)">ðŸ‡¦ðŸ‡º Australia â€” 40 Ã— 60 mm</option>
                                            </optgroup>
                                        </select>
                                    </div>

                                    <!-- How Many Photos -->
                                    <div>
                                        <label for="passport-photo-count" class="block text-xs font-bold text-gray-700 mb-1.5">
                                            <i class="fa-solid fa-layer-group text-fuchsia-500 mr-1"></i>How Many Photos Required?
                                        </label>
                                        <select id="passport-photo-count" onchange="updatePassportPhotoSelectionSummary()" class="w-full p-2.5 text-sm bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-fuchsia-500 focus:outline-none">
                                            <option value="4">4 photos (Quick Sample)</option>
                                            <option value="6">6 photos</option>
                                            <option value="8" selected>8 photos (Recommended for 1 A4 Row/Grid)</option>
                                            <option value="12">12 photos</option>
                                            <option value="16">16 photos</option>
                                            <option value="20">20 photos</option>
                                            <option value="24">24 photos</option>
                                            <option value="32">32 photos (Full A4 Sheet)</option>
                                        </select>
                                    </div>

                                    <!-- Photo Background Backdrop -->
                                    <div>
                                        <label class="block text-xs font-bold text-gray-700 mb-1.5">
                                            <i class="fa-solid fa-fill-drip text-fuchsia-500 mr-1"></i>Photo Background Backdrop
                                        </label>
                                        <div class="grid grid-cols-4 gap-2 text-center text-xs">
                                            <label class="cursor-pointer border-2 border-fuchsia-500 rounded-xl p-2 bg-white flex flex-col items-center gap-1 hover:border-fuchsia-400 has-[:checked]:border-fuchsia-600 has-[:checked]:bg-fuchsia-50/50">
                                                <input type="radio" name="passport-bg-choice" value="original" checked onchange="handlePassportBgChoice(this.value)" class="accent-fuchsia-600 sr-only">
                                                <span class="w-5 h-5 rounded-full border border-gray-300 bg-transparent flex items-center justify-center text-[10px] text-gray-600"><i class="fa-solid fa-image"></i></span>
                                                <span class="text-[11px] font-semibold text-gray-800">Original</span>
                                            </label>
                                            <label class="cursor-pointer border border-gray-200 rounded-xl p-2 bg-white flex flex-col items-center gap-1 hover:border-fuchsia-400 has-[:checked]:border-fuchsia-600 has-[:checked]:bg-fuchsia-50/50">
                                                <input type="radio" name="passport-bg-choice" value="#ffffff" onchange="handlePassportBgChoice(this.value)" class="accent-fuchsia-600 sr-only">
                                                <span class="w-5 h-5 rounded-full border border-gray-300 bg-white shadow-sm"></span>
                                                <span class="text-[11px] font-semibold text-gray-800">White</span>
                                            </label>
                                            <label class="cursor-pointer border border-gray-200 rounded-xl p-2 bg-white flex flex-col items-center gap-1 hover:border-fuchsia-400 has-[:checked]:border-fuchsia-600 has-[:checked]:bg-fuchsia-50/50">
                                                <input type="radio" name="passport-bg-choice" value="#cbe4fb" onchange="handlePassportBgChoice(this.value)" class="accent-fuchsia-600 sr-only">
                                                <span class="w-5 h-5 rounded-full border border-blue-200 bg-[#cbe4fb] shadow-sm"></span>
                                                <span class="text-[11px] font-semibold text-gray-800">Light Blue</span>
                                            </label>
                                            <label class="cursor-pointer border border-gray-200 rounded-xl p-2 bg-white flex flex-col items-center gap-1 hover:border-fuchsia-400 has-[:checked]:border-fuchsia-600 has-[:checked]:bg-fuchsia-50/50">
                                                <input type="radio" name="passport-bg-choice" value="#e2e8f0" onchange="handlePassportBgChoice(this.value)" class="accent-fuchsia-600 sr-only">
                                                <span class="w-5 h-5 rounded-full border border-slate-300 bg-[#e2e8f0] shadow-sm"></span>
                                                <span class="text-[11px] font-semibold text-gray-800">Light Gray</span>
                                            </label>
                                        </div>
                                    </div>

                                    <!-- Output summary badge -->
                                    <div class="rounded-xl bg-slate-50 border border-slate-200 p-3 flex gap-3">
                                        <span class="w-8 h-8 shrink-0 rounded-lg bg-slate-800 text-white flex items-center justify-center text-xs"><i class="fa-solid fa-file-lines"></i></span>
                                        <div>
                                            <div class="text-xs font-bold text-slate-800">Output: A4 photo sheet</div>
                                            <p id="passport-selection-summary" class="text-[11px] text-slate-500 mt-0.5">8 Indian Passport photos (35 Ã— 45 mm), arranged for A4 printing.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- â•â•â•â•â•â• END SLIDE 1 â•â•â•â•â•â• -->

                            <!-- â•â•â•â•â•â• SLIDE 2: CROP & ADJUST â•â•â•â•â•â• -->
                            <div class="pps-slide" id="pps-slide-2">
                                <div class="pps-slide-title">
                                    <span class="w-7 h-7 rounded-lg bg-fuchsia-100 text-fuchsia-700 flex items-center justify-center text-xs"><i class="fa-solid fa-crop-simple"></i></span>
                                    Crop &amp; Photo Adjustment
                                </div>

                                <div id="passport-photo-editor">
                                    <!-- Rotate / Reset controls -->
                                    <div class="flex items-center justify-end gap-2 mb-4">
                                        <button type="button" onclick="rotatePassportPhoto()" class="px-3 py-1.5 rounded-lg bg-fuchsia-50 hover:bg-fuchsia-100 text-fuchsia-700 text-[11px] font-semibold border border-fuchsia-200">
                                            <i class="fa-solid fa-rotate-right mr-1"></i> Rotate 90Â°
                                        </button>
                                        <button type="button" onclick="resetPassportPhotoEdits()" class="px-3 py-1.5 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-700 text-[11px] font-semibold">
                                            <i class="fa-solid fa-rotate-left mr-1"></i> Reset Edits
                                        </button>
                                    </div>

                                    <!-- Crop stage + controls -->
                                    <div class="grid md:grid-cols-[220px_1fr] gap-5 items-start">
                                        <div class="mx-auto w-full max-w-[220px]">
                                            <div id="passport-crop-stage" class="relative w-full overflow-hidden rounded-xl bg-slate-900 shadow-inner" style="aspect-ratio: 35 / 45;">
                                                <img id="passport-crop-image" class="absolute max-w-none select-none pointer-events-none" alt="Crop preview">
                                                <div class="absolute inset-0 border-2 border-white/90 rounded-xl pointer-events-none"></div>
                                                <div class="absolute inset-x-0 top-1/3 border-t border-white/50 pointer-events-none"></div>
                                                <div class="absolute inset-x-0 bottom-1/3 border-t border-white/50 pointer-events-none"></div>
                                            </div>
                                            <p class="text-center text-[10px] text-gray-400 mt-2">Live crop preview</p>
                                        </div>

                                        <div class="space-y-4">
                                            <!-- Crop Zoom -->
                                            <div class="rounded-xl border border-fuchsia-100 bg-fuchsia-50/60 p-3">
                                                <div class="flex items-center justify-between gap-3 mb-2">
                                                    <label for="passport-crop-zoom" class="text-xs font-bold text-gray-800">Crop Zoom</label>
                                                    <span id="passport-crop-zoom-value" class="text-[11px] font-semibold text-fuchsia-700">100%</span>
                                                </div>
                                                <input id="passport-crop-zoom" type="range" min="100" max="300" value="100" oninput="updatePassportCropFromControls()" class="w-full accent-fuchsia-600">
                                                <p class="text-[10px] text-gray-500 mt-1">Zoom in, then reposition to frame the face correctly.</p>
                                            </div>

                                            <!-- Pan X -->
                                            <div>
                                                <div class="flex items-center justify-between mb-1.5">
                                                    <label for="passport-crop-x" class="text-xs font-bold text-gray-700">Move Left / Right</label>
                                                    <span id="passport-crop-x-value" class="text-[10px] text-gray-500">Centre</span>
                                                </div>
                                                <input id="passport-crop-x" type="range" min="-100" max="100" value="0" oninput="updatePassportCropFromControls()" class="w-full accent-fuchsia-600">
                                            </div>

                                            <!-- Pan Y -->
                                            <div>
                                                <div class="flex items-center justify-between mb-1.5">
                                                    <label for="passport-crop-y" class="text-xs font-bold text-gray-700">Move Up / Down</label>
                                                    <span id="passport-crop-y-value" class="text-[10px] text-gray-500">Centre</span>
                                                </div>
                                                <input id="passport-crop-y" type="range" min="-100" max="100" value="0" oninput="updatePassportCropFromControls()" class="w-full accent-fuchsia-600">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- â•â•â•â•â•â• END SLIDE 2 â•â•â•â•â•â• -->

                            <!-- â•â•â•â•â•â• SLIDE 3: COLOR EDIT â•â•â•â•â•â• -->
                            <div class="pps-slide" id="pps-slide-3">
                                <div class="pps-slide-title">
                                    <span class="w-7 h-7 rounded-lg bg-fuchsia-100 text-fuchsia-700 flex items-center justify-center text-xs"><i class="fa-solid fa-palette"></i></span>
                                    Color Edit
                                </div>

                                <div class="space-y-4">
                                    <!-- Filter preset -->
                                    <div>
                                        <label for="passport-photo-filter" class="block text-xs font-bold text-gray-700 mb-1.5">
                                            <i class="fa-solid fa-wand-magic-sparkles text-fuchsia-500 mr-1"></i>Colour Filter Preset
                                        </label>
                                        <select id="passport-photo-filter" onchange="applyPassportPhotoFilterPreset()" class="w-full p-2.5 text-xs bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-fuchsia-500 focus:outline-none">
                                            <option value="original">Original colour</option>
                                            <option value="natural">Natural / balanced</option>
                                            <option value="vivid">Vivid colour</option>
                                            <option value="warm">Warm tone</option>
                                            <option value="soft">Soft light</option>
                                            <option value="bw">Black &amp; white</option>
                                            <option value="custom">Custom adjustment</option>
                                        </select>
                                    </div>

                                    <!-- Brightness -->
                                    <div>
                                        <div class="flex items-center justify-between mb-1.5">
                                            <label for="passport-photo-brightness" class="text-xs font-bold text-gray-700"><i class="fa-solid fa-sun text-amber-400 mr-1"></i>Brightness</label>
                                            <span id="passport-photo-brightness-value" class="text-[10px] text-gray-500">100%</span>
                                        </div>
                                        <input id="passport-photo-brightness" type="range" min="50" max="150" value="100" oninput="updatePassportColourFromControls()" class="w-full accent-fuchsia-600">
                                    </div>

                                    <!-- Contrast -->
                                    <div>
                                        <div class="flex items-center justify-between mb-1.5">
                                            <label for="passport-photo-contrast" class="text-xs font-bold text-gray-700"><i class="fa-solid fa-circle-half-stroke text-slate-500 mr-1"></i>Contrast</label>
                                            <span id="passport-photo-contrast-value" class="text-[10px] text-gray-500">100%</span>
                                        </div>
                                        <input id="passport-photo-contrast" type="range" min="50" max="160" value="100" oninput="updatePassportColourFromControls()" class="w-full accent-fuchsia-600">
                                    </div>

                                    <!-- Saturation -->
                                    <div>
                                        <div class="flex items-center justify-between mb-1.5">
                                            <label for="passport-photo-saturation" class="text-xs font-bold text-gray-700"><i class="fa-solid fa-droplet text-blue-400 mr-1"></i>Colour Saturation</label>
                                            <span id="passport-photo-saturation-value" class="text-[10px] text-gray-500">100%</span>
                                        </div>
                                        <input id="passport-photo-saturation" type="range" min="0" max="170" value="100" oninput="updatePassportColourFromControls()" class="w-full accent-fuchsia-600">
                                    </div>

                                    <!-- Softness / Blur -->
                                    <div>
                                        <div class="flex items-center justify-between mb-1.5">
                                            <label for="passport-photo-blur" class="text-xs font-bold text-gray-700"><i class="fa-solid fa-wind text-sky-400 mr-1"></i>Softness / Blur</label>
                                            <span id="passport-photo-blur-value" class="text-[10px] text-gray-500">0 px</span>
                                        </div>
                                        <input id="passport-photo-blur" type="range" min="0" max="4" step="0.1" value="0" oninput="updatePassportColourFromControls()" class="w-full accent-fuchsia-600">
                                    </div>

                                    <p class="text-[10px] text-gray-400 flex gap-1.5"><i class="fa-solid fa-circle-info mt-0.5"></i> Colour changes are applied to every copy on the A4 sheet.</p>
                                </div>
                            </div>
                            <!-- â•â•â•â•â•â• END SLIDE 3 â•â•â•â•â•â• -->

                        </div><!-- end pps-slides-track -->
                    </div><!-- end pps-slides-viewport -->

                    <!-- â”€â”€ NAVIGATION BAR (changes per step) â”€â”€ -->
                    <div class="pps-nav" id="pps-nav">
                        <!-- Rendered dynamically by goToPassportSlide() -->
                    </div>

                </div>
                <!-- â”€â”€â”€â”€ END RIGHT PANEL â”€â”€â”€â”€ -->

            </div><!-- end pps-body (editing mode) -->

            <!-- â•â•â• A4 LAYOUT VIEW (replaces body on Generate) â•â•â• -->
            <div id="pps-layout-view" class="hidden flex-col flex-1 min-h-0 overflow-hidden">
                <!-- Layout header -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 px-5 py-3 border-b border-gray-100 bg-white">
                    <div>
                        <h4 class="font-bold text-gray-900 text-sm">Ready-to-print A4 layout</h4>
                        <p id="passport-layout-summary" class="text-xs text-gray-500 mt-0.5"></p>
                    </div>
                    <button type="button" onclick="showPassportPhotoUpload()" class="shrink-0 px-3 py-2 rounded-lg border border-gray-300 bg-white hover:bg-gray-50 text-gray-700 text-xs font-semibold">
                        <i class="fa-solid fa-arrow-left mr-1"></i> Edit Photo / Settings
                    </button>
                </div>

                <!-- A4 sheet preview scroll area -->
                <div class="pps-layout-scroll">
                    <div id="passport-print-area" class="space-y-6"></div>
                </div>

                <!-- Print / Download footer -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 px-5 py-3 border-t border-gray-200 bg-white">
                    <p class="text-[11px] text-gray-500"><i class="fa-solid fa-circle-info text-fuchsia-600 mr-1"></i> In print dialog, select <strong>A4</strong>, portrait, and <strong>100% / Actual size</strong> for exact dimensions.</p>
                    <div class="flex flex-wrap items-center gap-2">
                        <button type="button" onclick="downloadPassportSinglePhoto()" class="px-3.5 py-2.5 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 font-semibold rounded-xl text-xs flex items-center gap-1.5 shadow-sm">
                            <i class="fa-solid fa-file-arrow-down text-fuchsia-600"></i> Single Photo (HD)
                        </button>
                        <button type="button" onclick="downloadPassportPhotoSheet()" class="px-3.5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold rounded-xl text-xs flex items-center gap-1.5 shadow-sm">
                            <i class="fa-solid fa-download"></i> Save A4 Image
                        </button>
                        <button type="button" onclick="printPassportPhotoSheet()" class="px-4 py-2.5 bg-fuchsia-600 hover:bg-fuchsia-700 text-white font-semibold rounded-xl text-xs flex items-center gap-2 shadow-sm">
                            <i class="fa-solid fa-print"></i> Print A4 Photo Sheet
                        </button>
                    </div>
                </div>
            </div>
            <!-- â•â•â• END LAYOUT VIEW â•â•â• -->

            <!-- Kept for legacy compatibility / print CSS targeting -->
            <div id="passport-photo-step-layout" class="hidden"></div>

        </div><!-- end pps-dialog -->
    </div>

    <!-- PDF TOOLS MODAL -->
    <div id="pdfToolsModal" class="fixed inset-0 z-[70] hidden items-center justify-center bg-slate-950/70 p-3 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="pdf-tools-title">
        <div class="flex h-[94vh] max-h-[94vh] w-full max-w-7xl flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl">
            <div class="flex shrink-0 items-start justify-between gap-4 border-b border-slate-200 bg-gradient-to-r from-rose-50 via-white to-violet-50 p-4 sm:p-5">
                <div>
                    <div class="flex flex-wrap items-center gap-2">
                        <h3 id="pdf-tools-title" class="text-lg font-bold text-slate-900"><i class="fa-solid fa-file-pdf mr-2 text-rose-600"></i>PDF Tools</h3>
                        <span class="rounded-full border border-emerald-200 bg-emerald-50 px-2 py-0.5 text-[10px] font-bold text-emerald-700"><i class="fa-solid fa-shield-halved mr-1"></i>Processed on this device</span>
                    </div>
                    <p class="mt-1 text-xs text-slate-600">Merge PDFs and images, convert JPG/PNG/WEBP to PDF, edit page order, rotate pages, and choose the output paper size.</p>
                </div>
                <button type="button" onclick="closePdfToolsModal()" class="rounded-lg p-2 text-slate-400 transition hover:bg-white hover:text-slate-700" aria-label="Close PDF tools"><i class="fa-solid fa-xmark text-lg"></i></button>
            </div>

            <div class="min-h-0 flex-1 overflow-y-auto bg-slate-50 p-4 sm:p-5">
                <div class="grid gap-4 xl:grid-cols-[1.2fr_0.8fr]">
                    <section class="space-y-4">
                        <div id="pdf-tools-dropzone" class="rounded-2xl border-2 border-dashed border-rose-200 bg-white p-5 text-center transition hover:border-rose-400 hover:bg-rose-50/30" ondragover="pdfToolsDragOver(event)" ondragleave="pdfToolsDragLeave(event)" ondrop="pdfToolsDrop(event)">
                            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-rose-100 text-xl text-rose-600"><i class="fa-solid fa-cloud-arrow-up"></i></div>
                            <h4 class="mt-3 text-sm font-bold text-slate-800">Add files to your PDF workspace</h4>
                            <p class="mx-auto mt-1 max-w-lg text-[11px] leading-relaxed text-slate-500">Choose many PDF, JPG, JPEG, PNG, or WEBP files at once, or choose a folder. Every page of an uploaded PDF can be reordered, rotated, or removed before download.</p>
                            <div class="mt-4 flex flex-wrap justify-center gap-2">
                                <label for="pdf-tools-files" class="cursor-pointer rounded-lg bg-rose-600 px-3 py-2 text-xs font-bold text-white transition hover:bg-rose-700"><i class="fa-solid fa-file-arrow-up mr-1"></i>Choose files</label>
                                <label for="pdf-tools-folder" class="cursor-pointer rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-bold text-slate-700 transition hover:bg-slate-50"><i class="fa-solid fa-folder-open mr-1"></i>Choose folder</label>
                            </div>
                            <input id="pdf-tools-files" type="file" accept="application/pdf,image/jpeg,image/png,image/webp,.pdf,.jpg,.jpeg,.png,.webp" multiple class="hidden" onchange="pdfToolsFilesSelected(event)">
                            <input id="pdf-tools-folder" type="file" accept="application/pdf,image/jpeg,image/png,image/webp,.pdf,.jpg,.jpeg,.png,.webp" multiple webkitdirectory directory class="hidden" onchange="pdfToolsFilesSelected(event)">
                        </div>

                        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
                            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 px-4 py-3">
                                <div>
                                    <h4 class="text-sm font-bold text-slate-800"><i class="fa-solid fa-layer-group mr-1 text-violet-600"></i>Pages in output order</h4>
                                    <p id="pdf-tools-page-count" class="mt-0.5 text-[11px] text-slate-500">No files added yet</p>
                                </div>
                                <div class="flex items-center gap-1.5 flex-wrap">
                                    <button type="button" onclick="rotateAllPdfToolsItems()" class="rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1.5 text-[11px] font-semibold text-slate-700 transition hover:bg-slate-100"><i class="fa-solid fa-rotate-right mr-1 text-amber-600"></i>Rotate All</button>
                                    <button type="button" onclick="reversePdfToolsItems()" class="rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1.5 text-[11px] font-semibold text-slate-700 transition hover:bg-slate-100"><i class="fa-solid fa-arrows-up-down mr-1 text-violet-600"></i>Reverse</button>
                                    <button type="button" onclick="clearPdfTools()" class="rounded-lg border border-rose-200 bg-rose-50 px-2.5 py-1.5 text-[11px] font-bold text-rose-700 transition hover:bg-rose-100"><i class="fa-solid fa-trash-can mr-1"></i>Clear all</button>
                                </div>
                            </div>
                            <div id="pdf-tools-page-list" class="grid max-h-[32rem] grid-cols-1 gap-3 overflow-y-auto p-3 sm:grid-cols-2 lg:grid-cols-3">
                                <div class="rounded-xl border border-dashed border-slate-200 bg-slate-50 px-4 py-6 text-center text-xs text-slate-500"><i class="fa-solid fa-file-circle-plus mb-2 block text-xl text-slate-300"></i>Add files above to start creating a PDF.</div>
                            </div>
                            <div class="border-t border-slate-100 bg-slate-50 px-4 py-2.5 text-[10px] leading-relaxed text-slate-500"><i class="fa-solid fa-hand-pointer mr-1 text-violet-500"></i><strong>Drag a preview card</strong> onto another card to place it before that page. The number badge is the exact output order. Click <strong>Preview</strong> to inspect a page in a larger view.</div>
                        </div>
                    </section>

                    <section class="space-y-4">
                        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
                            <div class="flex items-center justify-between gap-2">
                                <h4 class="text-sm font-bold text-slate-800"><i class="fa-solid fa-file-lines mr-1 text-violet-600"></i>PDF layout &amp; size</h4>
                                <span id="pdf-tools-paper-help" class="rounded-full bg-violet-50 px-2 py-0.5 text-[10px] font-bold text-violet-700">A4 Â· 210 Ã— 297 mm</span>
                            </div>
                            <div class="mt-3 grid grid-cols-2 gap-3">
                                <label class="text-[11px] font-semibold text-slate-600">Paper size
                                    <select id="pdf-tools-page-size" onchange="updatePdfToolsPaperHelp()" class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-2 text-xs text-slate-800 focus:border-violet-500 focus:outline-none">
                                        <option value="a4-p">A4 - Portrait</option>
                                        <option value="a4-l">A4 - Landscape</option>
                                        <option value="a1-p">A1 - Portrait</option>
                                        <option value="a1-l">A1 - Landscape</option>
                                        <option value="a2-p">A2 - Portrait</option>
                                        <option value="a2-l">A2 - Landscape</option>
                                        <option value="a3-p">A3 - Portrait</option>
                                        <option value="a3-l">A3 - Landscape</option>
                                        <option value="a5-p">A5 - Portrait</option>
                                        <option value="a5-l">A5 - Landscape</option>
                                        <option value="a6-p">A6 - Portrait</option>
                                        <option value="a6-l">A6 - Landscape</option>
                                        <option value="letter-p">Letter - Portrait</option>
                                        <option value="letter-l">Letter - Landscape</option>
                                        <option value="legal-p">Legal - Portrait</option>
                                        <option value="legal-l">Legal - Landscape</option>
                                        <option value="tabloid-p">Tabloid - Portrait</option>
                                        <option value="tabloid-l">Tabloid - Landscape</option>
                                    </select>
                                </label>
                                <label class="text-[11px] font-semibold text-slate-600">White margin
                                    <select id="pdf-tools-margin" class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-2 text-xs text-slate-800 focus:border-violet-500 focus:outline-none">
                                        <option value="0">No margin</option>
                                        <option value="14.17">5 mm</option>
                                        <option value="28.35" selected>10 mm</option>
                                        <option value="42.52">15 mm</option>
                                        <option value="56.69">20 mm</option>
                                    </select>
                                </label>
                            </div>
                            <label class="mt-3 flex cursor-pointer items-start gap-2 rounded-lg bg-violet-50 p-2.5 text-[11px] text-violet-950">
                                <input id="pdf-tools-fit-pdf" type="checkbox" checked class="mt-0.5 h-3.5 w-3.5 accent-violet-600">
                                <span><strong>Fit imported PDF pages to the selected paper size.</strong><br><span class="text-violet-700">Turn off to retain each original PDF page size; images will still use the selected size.</span></span>
                            </label>
                        </div>

                        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
                            <h4 class="text-sm font-bold text-slate-800"><i class="fa-solid fa-compress mr-1 text-amber-600"></i>Image PDF quality / file size</h4>
                            <label class="mt-3 block text-[11px] font-semibold text-slate-600">Image compression
                                <select id="pdf-tools-image-quality" class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-2 text-xs text-slate-800 focus:border-violet-500 focus:outline-none">
                                    <option value="compact">Compact - smaller PDF (about 60%)</option>
                                    <option value="balanced" selected>Balanced - clear &amp; smaller (about 82%)</option>
                                    <option value="high">High quality - larger PDF (about 94%)</option>
                                    <option value="original">Original image quality - largest file</option>
                                </select>
                            </label>
                            <p class="mt-2 text-[10px] leading-relaxed text-slate-500">Use Compact to reduce JPG/PNG PDF size. Use High or Original for printing. PNG and WEBP may be converted to JPEG when a compression level is selected.</p>
                        </div>

                        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
                            <h4 class="text-sm font-bold text-slate-800"><i class="fa-solid fa-pen-to-square mr-1 text-cyan-600"></i>Basic PDF edit</h4>
                            <p class="mt-1 text-[10px] text-slate-500">Add optional text to every output page. Page order, remove, and rotate controls are in the list.</p>
                            <div class="mt-3 grid grid-cols-[1fr_112px] gap-3">
                                <label class="text-[11px] font-semibold text-slate-600">Text / watermark
                                    <input id="pdf-tools-stamp-text" maxlength="100" placeholder="e.g. Customer copy" class="mt-1 w-full rounded-lg border border-slate-300 p-2 text-xs font-normal text-slate-800 placeholder:text-slate-400 focus:border-violet-500 focus:outline-none">
                                </label>
                                <label class="text-[11px] font-semibold text-slate-600">Position
                                    <select id="pdf-tools-stamp-position" class="mt-1 w-full rounded-lg border border-slate-300 bg-white p-2 text-xs font-normal text-slate-800 focus:border-violet-500 focus:outline-none">
                                        <option value="bottom-right">Bottom right</option>
                                        <option value="bottom-left">Bottom left</option>
                                        <option value="top-right">Top right</option>
                                        <option value="top-left">Top left</option>
                                        <option value="center">Centre</option>
                                    </select>
                                </label>
                            </div>
                        </div>
                    </section>
                </div>
            </div>

            <div class="shrink-0 border-t border-slate-200 bg-white p-4 sm:px-5">
                <div id="pdf-tools-status" class="hidden mb-3 rounded-lg px-3 py-2 text-xs" role="status"></div>
                <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
                    <label class="block text-[11px] font-semibold text-slate-600">Output file name
                        <input id="pdf-tools-output-name" value="merged-document" maxlength="80" class="mt-1 w-full min-w-[220px] rounded-lg border border-slate-300 p-2 text-xs font-normal text-slate-800 focus:border-violet-500 focus:outline-none">
                    </label>
                    <div class="flex gap-2">
                        <button type="button" onclick="closePdfToolsModal()" class="rounded-xl bg-slate-100 px-4 py-2.5 text-xs font-bold text-slate-700 transition hover:bg-slate-200">Cancel</button>
                        <button id="pdf-tools-create-btn" type="button" onclick="createPdfFromTools()" disabled class="rounded-xl bg-rose-600 px-4 py-2.5 text-xs font-bold text-white shadow-sm transition hover:bg-rose-700 disabled:cursor-not-allowed disabled:bg-rose-200 disabled:text-rose-500"><i class="fa-solid fa-file-arrow-down mr-1"></i>Create &amp; download PDF</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- LARGE PAGE PREVIEW FOR PDF TOOLS -->
    <div id="pdfToolsPagePreviewModal" class="fixed inset-0 z-[80] hidden items-center justify-center bg-slate-950/80 p-4 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="pdf-tools-preview-title">
        <div class="flex h-[92vh] w-full max-w-5xl flex-col overflow-hidden rounded-2xl bg-white shadow-2xl">
            <div class="flex shrink-0 items-center justify-between gap-3 border-b border-slate-200 bg-slate-50 px-4 py-3 sm:px-5">
                <div class="min-w-0">
                    <h3 id="pdf-tools-preview-title" class="truncate text-sm font-bold text-slate-900">Page preview</h3>
                    <p id="pdf-tools-preview-detail" class="mt-0.5 truncate text-[11px] text-slate-500">Loading previewâ€¦</p>
                </div>
                <button type="button" onclick="closePdfToolsPagePreview()" class="rounded-lg p-2 text-slate-400 transition hover:bg-white hover:text-slate-700" aria-label="Close page preview"><i class="fa-solid fa-xmark text-lg"></i></button>
            </div>
            <div class="min-h-0 flex-1 overflow-auto bg-slate-200 p-4 sm:p-6">
                <div id="pdf-tools-preview-loading" class="flex h-full min-h-56 items-center justify-center text-sm font-semibold text-slate-500"><i class="fa-solid fa-spinner fa-spin mr-2 text-violet-600"></i>Rendering page previewâ€¦</div>
                <img id="pdf-tools-preview-image" class="mx-auto hidden max-w-full rounded-sm bg-white shadow-xl" alt="Selected PDF page preview">
            </div>
        </div>
    </div>

    <!-- PHOTO & SIGNATURE EDITOR MODAL -->
    <div id="imageEditorModal" class="fixed inset-0 z-50 flex hidden items-center justify-center bg-black/60 p-3 backdrop-blur-sm">
        <div class="flex h-[94vh] max-h-[94vh] w-full max-w-5xl flex-col overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-2xl">
            <div class="z-10 shrink-0 flex items-start justify-between gap-4 border-b border-gray-100 bg-white p-5">
                <div>
                    <h3 class="text-lg font-bold text-gray-900 flex items-center gap-2"><i class="fa-solid fa-wand-magic-sparkles text-cyan-600"></i> Online Photo &amp; Signature Editor</h3>
                    <p class="mt-1 text-xs text-gray-500">Crop the image and its final frame separately, choose a standard form frame, then download in PNG, JPG, or JPEG format.</p>
                </div>
                <button type="button" onclick="closeImageEditorModal()" class="rounded-lg p-1.5 text-gray-400 hover:bg-gray-100 hover:text-gray-700" aria-label="Close editor"><i class="fa-solid fa-xmark text-lg"></i></button>
            </div>

            <div class="flex min-h-0 flex-1 flex-col overflow-hidden p-5">
                <div class="shrink-0 grid grid-cols-2 gap-2 rounded-xl bg-cyan-50 p-2" role="tablist" aria-label="Image editor section">
                    <button id="image-editor-photo-tab" type="button" onclick="selectImageEditorType('photo')" class="rounded-lg bg-cyan-600 px-3 py-2.5 text-xs font-bold text-white shadow-sm" aria-selected="true"><i class="fa-solid fa-image mr-1"></i> Photo Section</button>
                    <button id="image-editor-signature-tab" type="button" onclick="selectImageEditorType('signature')" class="rounded-lg px-3 py-2.5 text-xs font-bold text-cyan-800 hover:bg-white" aria-selected="false"><i class="fa-solid fa-signature mr-1"></i> Signature Section</button>
                </div>

                <div class="mt-4 grid min-h-0 flex-1 grid-rows-[auto_minmax(0,1fr)] gap-5 lg:grid-cols-[minmax(0,1fr)_300px] lg:grid-rows-1">
                    <div id="image-editor-preview-pane" class="h-fit self-start rounded-2xl border border-slate-200 bg-slate-50 p-3 sm:p-4 lg:sticky lg:top-0">
                        <div id="image-editor-empty-preview" class="flex min-h-[280px] items-center justify-center rounded-xl border-2 border-dashed border-slate-200 bg-white p-6 text-center text-sm text-slate-400">
                            <div><i class="fa-regular fa-image mb-3 block text-4xl text-cyan-300"></i>Upload an image, then select <strong>Edit Image</strong>.</div>
                        </div>
                        <canvas id="image-editor-canvas" class="hidden mx-auto max-h-[30vh] max-w-full rounded-xl bg-white shadow-sm sm:max-h-[40vh] lg:max-h-[52vh]"></canvas>
                        <p id="image-editor-preview-note" class="mt-3 hidden text-center text-[11px] text-gray-500">Preview shows the cropped and filtered output.</p>
                    </div>

                    <div id="image-editor-tools-pane" class="min-h-0 space-y-4 overflow-y-auto pr-1 pb-1">
                        <div class="rounded-xl border border-cyan-100 bg-cyan-50/70 p-3">
                            <label for="image-editor-upload" class="mb-1.5 block text-xs font-bold text-cyan-950"><span id="image-editor-upload-label">Photo</span> upload</label>
                            <input id="image-editor-upload" type="file" accept="image/png,image/jpeg,image/jpg,image/webp" onchange="imageEditorFileSelected(event)" class="block w-full text-xs text-gray-600 file:mr-3 file:rounded-lg file:border-0 file:bg-cyan-600 file:px-3 file:py-2 file:text-xs file:font-semibold file:text-white hover:file:bg-cyan-700">
                            <p id="image-editor-file-name" class="mt-2 break-all text-[11px] text-cyan-800">PNG, JPG, JPEG, or WEBP Â· processed only in this browser</p>
                            <button id="image-editor-edit-btn" type="button" onclick="beginImageEdit()" disabled class="mt-3 w-full rounded-lg bg-cyan-600 px-3 py-2 text-xs font-bold text-white transition hover:bg-cyan-700 disabled:cursor-not-allowed disabled:bg-cyan-200">Edit Image</button>
                        </div>

                        <div id="image-editor-controls" class="hidden space-y-3">
                            <div class="overflow-hidden rounded-xl border border-gray-200 bg-white">
                                <div class="border-b border-gray-100 bg-slate-50 p-3">
                                    <div class="mb-2 flex items-center justify-between gap-2">
                                        <p id="image-editor-step-count" class="text-[10px] font-bold uppercase tracking-wide text-cyan-700">Step 1 of 4</p>
                                        <p id="image-editor-step-title" class="text-[11px] font-semibold text-slate-700">Suggested standard frame</p>
                                    </div>
                                    <div class="grid grid-cols-4 gap-1" role="tablist" aria-label="Photo and signature editor steps">
                                        <button id="image-editor-step-button-0" type="button" onclick="setImageEditorStep(0)" class="rounded-lg bg-cyan-600 px-1 py-2 text-[10px] font-bold text-white" aria-selected="true">1<br><span class="font-medium">Frame</span></button>
                                        <button id="image-editor-step-button-1" type="button" onclick="setImageEditorStep(1)" class="rounded-lg px-1 py-2 text-[10px] font-bold text-slate-500 hover:bg-white" aria-selected="false">2<br><span class="font-medium">Crop</span></button>
                                        <button id="image-editor-step-button-2" type="button" onclick="setImageEditorStep(2)" class="rounded-lg px-1 py-2 text-[10px] font-bold text-slate-500 hover:bg-white" aria-selected="false">3<br><span class="font-medium">Filter</span></button>
                                        <button id="image-editor-step-button-3" type="button" onclick="setImageEditorStep(3)" class="rounded-lg px-1 py-2 text-[10px] font-bold text-slate-500 hover:bg-white" aria-selected="false">4<br><span class="font-medium">Output</span></button>
                                    </div>
                                    <div class="mt-2 h-1 overflow-hidden rounded-full bg-slate-200"><div id="image-editor-step-progress" class="h-full w-1/4 rounded-full bg-cyan-600 transition-all duration-200"></div></div>
                                </div>

                                <div class="p-3">
                                    <section id="image-editor-step-panel-0" data-image-editor-step-panel="0">
                                        <div class="rounded-xl border border-cyan-100 bg-cyan-50/60 p-3">
                                            <h4 id="image-editor-frame-heading" class="text-xs font-bold text-cyan-950"><i class="fa-solid fa-id-card-clip mr-1 text-cyan-600"></i> Suggested standard photo frames</h4>
                                            <p id="image-editor-suggested-frames-help" class="mt-1 text-[10px] text-cyan-800">Choose a commonly used photo frame, then continue to crop and position it.</p>
                                            <div id="image-editor-frame-presets" class="mt-3 grid grid-cols-2 gap-2"></div>
                                            <p id="image-editor-active-frame" class="mt-2 rounded-lg border border-cyan-200 bg-white px-2 py-1.5 text-[10px] font-semibold text-cyan-800">Active frame: Custom</p>
                                        </div>
                                    </section>

                                    <section id="image-editor-step-panel-1" data-image-editor-step-panel="1" class="hidden">
                                        <div class="rounded-xl border border-gray-200 p-3">
                                            <div class="mb-2 flex items-center justify-between"><h4 id="image-editor-position-heading" class="text-xs font-bold text-gray-900"><i class="fa-solid fa-crop-simple mr-1 text-cyan-600"></i> Photo crop, zoom &amp; move</h4><button type="button" onclick="resetImageEditorCropAndPosition()" class="text-[11px] font-semibold text-cyan-700 hover:underline">Reset</button></div>
                                            <p id="image-editor-position-help" class="mb-3 text-[10px] text-gray-500">Use the selected frame as the crop shape, then zoom and move the photo until it is positioned correctly.</p>
                                            <label class="mb-3 block text-[11px] font-semibold text-gray-600">Crop <span id="image-editor-crop-value" class="float-right text-cyan-700">100%</span><input id="image-editor-crop" type="range" min="25" max="100" value="100" oninput="updateImageEditorControls()" class="mt-1 w-full accent-cyan-600"></label>
                                            <label class="mb-3 block text-[11px] font-semibold text-gray-600">Zoom <span id="image-editor-zoom-value" class="float-right text-cyan-700">100%</span><input id="image-editor-zoom" type="range" min="100" max="300" value="100" oninput="updateImageEditorControls()" class="mt-1 w-full accent-cyan-600"></label>
                                            <label class="mb-3 block text-[11px] font-semibold text-gray-600">Move left / right <span id="image-editor-move-x-value" class="float-right text-cyan-700">Centre</span><input id="image-editor-move-x" type="range" min="-100" max="100" value="0" oninput="updateImageEditorControls()" class="mt-1 w-full accent-cyan-600"></label>
                                            <label class="block text-[11px] font-semibold text-gray-600">Move up / down <span id="image-editor-move-y-value" class="float-right text-cyan-700">Centre</span><input id="image-editor-move-y" type="range" min="-100" max="100" value="0" oninput="updateImageEditorControls()" class="mt-1 w-full accent-cyan-600"></label>
                                        </div>
                                    </section>

                                    <section id="image-editor-step-panel-2" data-image-editor-step-panel="2" class="hidden">
                                        <div class="rounded-xl border border-gray-200 p-3">
                                            <h4 class="mb-3 text-xs font-bold text-gray-900"><i class="fa-solid fa-sliders mr-1 text-cyan-600"></i> Filters &amp; Adjustments</h4>
                                            <label class="mb-3 block text-[11px] font-semibold text-gray-600">Brightness <span id="image-editor-brightness-value" class="float-right text-cyan-700">100%</span><input id="image-editor-brightness" type="range" min="50" max="150" value="100" oninput="updateImageEditorControls()" class="mt-1 w-full accent-cyan-600"></label>
                                            <label class="mb-3 block text-[11px] font-semibold text-gray-600">Contrast <span id="image-editor-contrast-value" class="float-right text-cyan-700">100%</span><input id="image-editor-contrast" type="range" min="50" max="160" value="100" oninput="updateImageEditorControls()" class="mt-1 w-full accent-cyan-600"></label>
                                            <label class="mb-3 block text-[11px] font-semibold text-gray-600">Saturation <span id="image-editor-saturation-value" class="float-right text-cyan-700">100%</span><input id="image-editor-saturation" type="range" min="0" max="200" value="100" oninput="updateImageEditorControls()" class="mt-1 w-full accent-cyan-600"></label>
                                            <label class="mb-3 block text-[11px] font-semibold text-gray-600">Grayscale <span id="image-editor-grayscale-value" class="float-right text-cyan-700">0%</span><input id="image-editor-grayscale" type="range" min="0" max="100" value="0" oninput="updateImageEditorControls()" class="mt-1 w-full accent-cyan-600"></label>
                                            <label class="block text-[11px] font-semibold text-gray-600">Sepia <span id="image-editor-sepia-value" class="float-right text-cyan-700">0%</span><input id="image-editor-sepia" type="range" min="0" max="100" value="0" oninput="updateImageEditorControls()" class="mt-1 w-full accent-cyan-600"></label>
                                        </div>
                                    </section>

                                    <section id="image-editor-step-panel-3" data-image-editor-step-panel="3" class="hidden">
                                        <div class="rounded-xl border border-gray-200 p-3">
                                            <h4 class="mb-1 text-xs font-bold text-gray-900"><i class="fa-solid fa-expand mr-1 text-cyan-600"></i> Output size &amp; format</h4>
                                            <p class="mb-3 text-[10px] text-gray-500">A suggested frame sets this size automatically. Use custom values only when a form specifies another size.</p>
                                            <div class="grid grid-cols-2 gap-2">
                                                <label class="text-[11px] font-semibold text-gray-600">Width (px)<input id="image-editor-width" type="number" min="1" max="4000" value="600" oninput="updateImageEditorControls()" class="mt-1 w-full rounded-lg border border-gray-300 p-2 text-xs"></label>
                                                <label class="text-[11px] font-semibold text-gray-600">Height (px)<input id="image-editor-height" type="number" min="1" max="4000" value="400" oninput="updateImageEditorControls()" class="mt-1 w-full rounded-lg border border-gray-300 p-2 text-xs"></label>
                                            </div>
                                            <div class="mt-2 flex flex-wrap gap-1.5">
                                                <button type="button" onclick="setImageEditorSize(413, 531)" class="rounded-lg border border-cyan-200 px-2 py-1 text-[10px] font-semibold text-cyan-700 hover:bg-cyan-50">Passport</button>
                                                <button type="button" onclick="setImageEditorSize(213, 213)" class="rounded-lg border border-cyan-200 px-2 py-1 text-[10px] font-semibold text-cyan-700 hover:bg-cyan-50">PAN Photo</button>
                                                <button type="button" onclick="setImageEditorSize(600, 200)" class="rounded-lg border border-cyan-200 px-2 py-1 text-[10px] font-semibold text-cyan-700 hover:bg-cyan-50">Signature (Std)</button>
                                                <button type="button" onclick="setImageEditorSize(140, 60)" class="rounded-lg border border-cyan-200 px-2 py-1 text-[10px] font-semibold text-cyan-700 hover:bg-cyan-50">Sign (SSC)</button>
                                                <button type="button" onclick="setImageEditorOriginalSize()" class="rounded-lg border border-cyan-200 px-2 py-1 text-[10px] font-semibold text-cyan-700 hover:bg-cyan-50">Original</button>
                                            </div>
                                            <label class="mt-3 block text-[11px] font-semibold text-gray-600">Download format
                                                <select id="image-editor-format" onchange="updateImageEditorControls()" class="mt-1 w-full rounded-lg border border-gray-300 bg-white p-2 text-xs">
                                                    <option value="png">PNG (Clear / Transparent)</option>
                                                    <option value="jpg">JPG (Small File Size)</option>
                                                    <option value="jpeg">JPEG (Government Portals)</option>
                                                </select>
                                            </label>
                                            <label class="mt-3 block text-[11px] font-semibold text-gray-600">Target file size (KB) â€” auto compress
                                                <input id="image-editor-target-size-kb" type="number" min="1" max="10240" step="1" inputmode="numeric" placeholder="e.g. 20, 50 or 100" oninput="updateImageEditorControls()" class="mt-1 w-full rounded-lg border border-gray-300 p-2 text-xs">
                                            </label>
                                            <p id="image-editor-target-size-help" class="mt-1 text-[10px] text-gray-500">Optional. Type 20, 50, etc. JPEG optimizes to fit target file size limit for government forms.</p>
                                        </div>
                                    </section>

                                    <div class="mt-3 flex items-center justify-between gap-2 border-t border-gray-100 pt-3">
                                        <button id="image-editor-step-prev" type="button" onclick="moveImageEditorStep(-1)" class="rounded-lg border border-slate-200 px-3 py-2 text-[11px] font-semibold text-slate-600 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40"><i class="fa-solid fa-arrow-left mr-1"></i> Previous</button>
                                        <button id="image-editor-step-next" type="button" onclick="moveImageEditorStep(1)" class="rounded-lg bg-cyan-600 px-3 py-2 text-[11px] font-semibold text-white transition hover:bg-cyan-700">Next: Crop <i class="fa-solid fa-arrow-right ml-1"></i></button>
                                    </div>
                                </div>
                            </div>

                            <div id="image-editor-final-actions" class="hidden space-y-2">
                                <div id="image-editor-status" class="hidden rounded-lg px-3 py-2 text-xs" role="status"></div>
                                <button type="button" onclick="submitImageEdit()" class="w-full rounded-xl bg-cyan-600 px-4 py-3 text-xs font-bold text-white shadow-sm transition hover:bg-cyan-700 flex items-center justify-center gap-1.5"><i class="fa-solid fa-check"></i> Generate Output</button>
                                <div id="image-editor-download-group" class="hidden flex flex-col gap-2">
                                    <button id="image-editor-download-btn" type="button" onclick="downloadEditedImage()" class="w-full rounded-xl bg-emerald-600 px-4 py-3 text-xs font-bold text-white shadow-sm transition hover:bg-emerald-700 flex items-center justify-center gap-1.5"><i class="fa-solid fa-download"></i> Download Edited Image</button>
                                    <button id="image-editor-copy-btn" type="button" onclick="copyEditedImageToClipboard()" class="w-full rounded-xl bg-slate-800 hover:bg-slate-900 px-4 py-2.5 text-xs font-bold text-white shadow-sm transition flex items-center justify-center gap-1.5"><i class="fa-regular fa-copy"></i> Copy to Clipboard</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL 4: ADD TRANSACTION MODAL -->
    <div id="addTransactionModal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-gray-100 relative">
            <button onclick="closeTransactionModal()" class="absolute top-4 right-4 text-gray-400 hover:text-gray-700 text-lg">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <h3 class="text-lg font-bold text-gray-900 mb-1 flex items-center gap-2">
                <i class="fa-solid fa-wallet text-teal-600"></i> Record <span id="txn-type-title">Transaction</span>
            </h3>
            <p class="text-xs text-gray-500 mb-4">Add new ledger record for income or expense</p>

            <form id="add-transaction-form" onsubmit="handleTransactionSubmit(event)">
                <input type="hidden" id="modal-txn-type" value="Income">
                <div id="transaction-form-alert" class="hidden mb-3 rounded-lg px-3 py-2 text-xs" role="alert"></div>
                <div class="space-y-3 text-left">
                    <div>
                        <label class="block text-xs font-semibold text-gray-700 mb-1">Particulars / Customer / Vendor</label>
                        <input type="text" id="modal-txn-name" placeholder="e.g. Paper Purchase / Customer Name" required class="!mb-0 !p-2 text-xs bg-gray-50 border border-gray-300 rounded-lg">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-700 mb-1">Category / Service</label>
                        <input type="text" id="modal-txn-cat" placeholder="e.g. CSC Fee / Printing Paper" required class="!mb-0 !p-2 text-xs bg-gray-50 border border-gray-300 rounded-lg">
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-semibold text-gray-700 mb-1">Amount (â‚¹)</label>
                        <input type="number" id="modal-txn-amount" placeholder="0.00" min="0.01" step="0.01" required class="!mb-0 !p-2 text-xs bg-gray-50 border border-gray-300 rounded-lg">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-700 mb-1">Payment Method</label>
                            <select id="modal-txn-method" class="w-full p-2 text-xs bg-gray-50 border border-gray-300 rounded-lg">
                                <option value="UPI">PhonePe / UPI</option>
                                <option value="Cash">Cash</option>
                                <option value="Card">Card</option>
                                <option value="Bank">Bank Transfer</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="mt-5 flex gap-2">
                    <button type="button" onclick="closeTransactionModal()" class="w-1/2 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold rounded-lg text-xs">Cancel</button>
                    <button type="submit" id="transaction-save-btn" class="w-1/2 py-2 bg-teal-600 hover:bg-teal-700 text-white font-semibold rounded-lg text-xs">Record Transaction</button>
                </div>
            </form>
        </div>
    </div>

