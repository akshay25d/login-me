    <!-- MODAL 1: ADD CUSTOMER MODAL -->
    <div id="addCustomerModal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-gray-100 relative">
            <button onclick="closeCustomerModal()" class="absolute top-4 right-4 text-gray-400 hover:text-gray-700 text-lg">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <h3 class="text-lg font-bold text-gray-900 mb-1 flex items-center gap-2">
                <i class="fa-solid fa-user-plus text-indigo-600"></i> <span id="customer-modal-title">Add New Customer</span>
            </h3>
            <p class="text-xs text-gray-500 mb-4">Register new customer order details into the CSC dashboard</p>

            <form id="add-customer-form" onsubmit="handleCustomerSubmit(event)">
                <div id="customer-form-alert" class="hidden mb-3 rounded-lg px-3 py-2 text-xs" role="alert"></div>
                <div class="space-y-3 text-left">
                    <div>
                        <label class="block text-xs font-semibold text-gray-700 mb-1">Customer Full Name</label>
                        <input type="text" id="modal-cust-name" placeholder="Enter name" required class="!mb-0 !p-2 text-xs bg-gray-50 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-700 mb-1">Mobile Number</label>
                        <input type="tel" id="modal-cust-phone" placeholder="10-digit mobile" inputmode="numeric" pattern="[0-9]{10}" maxlength="10" required class="!mb-0 !p-2 text-xs bg-gray-50 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-700 mb-1">Service Requested</label>
                        <input type="text" id="modal-cust-service" placeholder="e.g. Aadhaar Print / PAN Card" required class="!mb-0 !p-2 text-xs bg-gray-50 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500">
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-semibold text-gray-700 mb-1">Amount (â‚¹)</label>
                        <input type="number" id="modal-cust-amount" placeholder="Amount" min="0" step="0.01" required class="!mb-0 !p-2 text-xs bg-gray-50 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-700 mb-1">Payment Status</label>
                            <select id="modal-cust-status" class="w-full p-2 text-xs bg-gray-50 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500">
                                <option value="Paid">Paid</option>
                                <option value="Pending">Pending</option>
                                <option value="Completed">Completed</option>
                            </select>
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-700 mb-1">Payment Method</label>
                        <select id="modal-cust-method" class="w-full p-2 text-xs bg-gray-50 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500">
                            <option value="UPI">PhonePe / UPI</option>
                            <option value="Cash">Cash</option>
                            <option value="Card">Card</option>
                            <option value="Bank">Bank Transfer</option>
                        </select>
                    </div>
                </div>
                <div class="mt-5 flex gap-2">
                    <button type="button" onclick="closeCustomerModal()" class="w-1/2 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold rounded-lg text-xs">Cancel</button>
                    <button type="submit" id="customer-save-btn" class="w-1/2 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-lg text-xs">Save Customer</button>
                </div>
