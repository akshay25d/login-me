            <div class="space-y-4 mt-4">
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center">
                    <div class="bg-purple-50 p-3 rounded-xl border border-purple-100">
                        <div class="text-[10px] text-purple-700 font-semibold uppercase tracking-wide">Income</div>
                        <div class="text-lg font-bold text-purple-900 mt-1" id="report-income-amount">â‚¹0</div>
                    </div>
                    <div class="bg-rose-50 p-3 rounded-xl border border-rose-100">
                        <div class="text-[10px] text-rose-700 font-semibold uppercase tracking-wide">Expenses</div>
                        <div class="text-lg font-bold text-rose-900 mt-1" id="report-expense-amount">â‚¹0</div>
                    </div>
                    <div class="bg-emerald-50 p-3 rounded-xl border border-emerald-100">
                        <div class="text-[10px] text-emerald-700 font-semibold uppercase tracking-wide">Net profit</div>
                        <div class="text-lg font-bold text-emerald-900 mt-1" id="report-profit-amount">â‚¹0</div>
                    </div>
                    <div class="bg-sky-50 p-3 rounded-xl border border-sky-100">
                        <div class="text-[10px] text-sky-700 font-semibold uppercase tracking-wide">Transactions</div>
                        <div class="text-lg font-bold text-sky-900 mt-1" id="report-transaction-count">0</div>
                    </div>
                </div>

                <div class="grid sm:grid-cols-2 gap-3 text-xs">
                    <div class="border border-amber-200 bg-amber-50/50 rounded-xl p-3">
                        <div class="flex items-center justify-between text-amber-800"><span class="font-bold">Pending services</span><i class="fa-solid fa-clock"></i></div>
                        <div class="text-2xl font-bold text-amber-700 mt-1" id="report-pending-count">0</div>
                        <p class="text-[10px] text-amber-700 mt-1">Needs follow-up</p>
                    </div>
                    <div class="border border-teal-200 bg-teal-50/50 rounded-xl p-3">
                        <div class="flex items-center justify-between text-teal-800"><span class="font-bold">Completed services</span><i class="fa-solid fa-circle-check"></i></div>
                        <div class="text-2xl font-bold text-teal-700 mt-1" id="report-completed-count">0</div>
                        <p class="text-[10px] text-teal-700 mt-1"><span id="report-customer-count">0</span> <span id="report-customer-period">customer orders today</span></p>
                    </div>
                </div>

                <div class="border border-gray-200 rounded-xl p-3 text-xs">
                    <div class="flex items-center justify-between gap-2 mb-2">
                        <h4 class="font-bold text-gray-800">Income by payment method</h4>
                        <span id="report-payment-period" class="text-[10px] text-gray-400">Today</span>
                    </div>
                    <div id="report-payment-breakdown" class="grid grid-cols-2 sm:grid-cols-4 gap-2"></div>
                </div>

                <div class="border border-gray-200 rounded-xl p-3 text-xs">
                    <div class="flex items-center justify-between gap-2 mb-3">
                        <h4 class="font-bold text-gray-800">Top performing services</h4>
                        <span id="report-income-caption" class="text-[10px] text-gray-400">Income recorded today</span>
                    </div>
                    <div id="report-service-breakdown" class="space-y-3"></div>
                </div>

                <div class="flex items-center justify-between text-[10px] text-gray-400 px-1">
                    <span><i class="fa-solid fa-rotate text-emerald-600 mr-1"></i>Updates automatically when records change</span>
                    <span id="report-last-updated">Waiting for live dataâ€¦</span>
                </div>

                <button onclick="closeModal('reportsModal')" class="w-full py-2 bg-purple-600 hover:bg-purple-700 text-white font-semibold rounded-lg text-xs">Close Report</button>
