            <button onclick="closeModal('reportsModal')" class="absolute top-4 right-4 text-gray-400 hover:text-gray-700 text-lg">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <div class="pr-8 flex items-start justify-between gap-3">
                <div>
                    <h3 class="text-lg font-bold text-gray-900 mb-1 flex items-center gap-2">
                        <i class="fa-solid fa-chart-pie text-purple-600"></i> Cyber Cafe Business Report
                    </h3>
                    <p id="report-period-description" class="text-xs text-gray-500">Todayâ€™s live data from your saved income, expenses and customer records.</p>
                </div>
                <span id="report-live-status" class="shrink-0 inline-flex items-center gap-1.5 text-[10px] font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-1 rounded-full"><span class="relative flex h-2 w-2"><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span><span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span></span> LIVE</span>
            </div>

            <div class="mt-4 flex gap-2 rounded-xl border border-violet-100 bg-violet-50 p-2" role="tablist" aria-label="Report period">
                <button type="button" class="report-period-tab is-active flex-1" data-report-period="today" aria-selected="true" onclick="showBusinessReportPeriod('today')">
                    <i class="fa-regular fa-calendar-day mr-1"></i> Today Report
                </button>
                <button type="button" class="report-period-tab flex-1" data-report-period="lifetime" aria-selected="false" onclick="showBusinessReportPeriod('lifetime')">
                    <i class="fa-solid fa-chart-line mr-1"></i> Lifetime Report
                </button>
